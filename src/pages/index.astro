---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, PERSONAL_INFO, SKILLS, SOCIAL_LINKS, HONORS, WORK_EXPERIENCE, EDUCATION } from '../consts';

const coverImage = '/images/冥想系列-cover.webp';
const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 2014;
const meditationImages = [
	{ src: '/images/冥想系列-1754664750528.webp', title: '冥想系列 1', desc: '早期冥想探索，意识的初次解剖' },
	{ src: '/images/冥想系列-1754664757458.webp', title: '冥想系列 2', desc: '内心对话，矛盾与冲突的视觉化' },
	{ src: '/images/冥想系列-1754664764581.webp', title: '冥想系列 3', desc: '繁重压迫下的精神释放' },
	{ src: '/images/冥想系列-1754664772045.webp', title: '冥想系列 4', desc: '对立统一，真实的自我映射' },
	{ src: '/images/冥想系列-1754664780351.webp', title: '冥想系列 5', desc: '意识深处的宁静与动荡' },
	{ src: '/images/冥想系列-1754664786331.webp', title: '冥想系列 6', desc: '精神世界的数字重构' },
	{ src: '/images/冥想系列-1754664798635.webp', title: '冥想系列 7', desc: '内在探索的第七阶段' },
	{ src: '/images/冥想系列-1754664814920.webp', title: '冥想系列 8', desc: '接近实相的道路' },
	{ src: '/images/冥想系列-1754664822895.webp', title: '冥想系列 9', desc: '意识的最终形态' },
	{ src: '/images/冥想系列-1754664829706.webp', title: '冥想系列 10', desc: '冥想之旅的终点与起点' }
];

// 跑马灯素材：仅限 cgartlab.com 文章标题 + 文章金句
const tickerItems = [
	'Men（门）Agent 团队',
	'你不知道的 AI 优雅食用指南（一）：慢一点比较快',
	'我的上帝模式：一名设计师创作环境的演变',
	'Inkard 卡片生成器',
	'自动给文章术语加百科链接',
	'Argus 前端设计代码审查 Agent',
	'Go To GitHub 访问加速工具',
	'EDIC 设计系统：面向人类与 Agent 的编辑主义设计系统',
	'世界尽管让它去转，不用担心你学的东西会过时',
	'就算掌声无法抵达舞台，我依然劝你尽快动笔',
	'RSS 与现代阅读习惯：重新获取信息收集的主动权',
	'大型三维设计项目实战心得：小小的文件命名',
	'十五年的浏览器折腾之旅',
	'碎片写作——建立一具思维标本',
	'用小学数学破除情绪的二元对立',
	'冥想系列：解剖自己内心的过程',
	'面对 AI，我们和长辈其实没什么两样——都习惯了执行规则，却从未学习设计规则',
	'从「规则执行者」到「规则设计师」，慢一点，才能真正用好 AI',
	'互联网是一片大海，网站是浪花，而浏览器是你脚下的那块冲浪板',
	'电脑要换的，软件要更新的，只有数据不出意外是要伴随你一辈子的',
	'一个人独处时，如果你没有想起任何其他人，是快乐的',
	'写作是建立思维标本的过程：系统化地整理与表达思考',
	'什么更重要、什么最重要、是否具有长期价值——我的三板斧',
	'网页里那个「下载」图标越大，就越不是你要找的下载链接',
];
// ticker 几何与纵深：高低错落、长度不一（w=带宽, lx=左偏移, ad=方向）
const tickerRows = [
	{ top: 5,  dur: 40, sc: 0.6,  bl: 2.6, op: 0.3,  w: 82, lx: 0,  ad: 'normal' },
	{ top: 13, dur: 30, sc: 0.84, bl: 1.2, op: 0.5,  w: 95, lx: 5,  ad: 'normal' },
	{ top: 19, dur: 24, sc: 1.02, bl: 0.2, op: 0.82, w: 72, lx: 0,  ad: 'normal' },
	{ top: 26, dur: 46, sc: 0.7,  bl: 1.9, op: 0.4,  w: 88, lx: 12, ad: 'normal' },
	{ top: 68, dur: 48, sc: 0.64, bl: 2.3, op: 0.34, w: 85, lx: 14, ad: 'reverse' },
	{ top: 75, dur: 27, sc: 1.06, bl: 0,   op: 0.86, w: 62, lx: 0,  ad: 'reverse' },
	{ top: 82, dur: 35, sc: 0.86, bl: 1.0, op: 0.55, w: 93, lx: 6,  ad: 'reverse' },
	{ top: 90, dur: 42, sc: 0.6,  bl: 2.7, op: 0.28, w: 76, lx: 2,  ad: 'reverse' },
];
---

<!doctype html>
<html lang="zh-CN" style="color-scheme:dark">
	<head>
		<BaseHead title={SITE_TITLE} description={PERSONAL_INFO.description} />
	</head>
	<body>

	<a href="#slideshow" class="skip-link">跳到主内容</a>

		<!-- ═══ Immersive Header ═══ -->
		<header class="header" id="header">
			<a href="/" class="header-logo">CHEN YANG</a>
			<nav class="header-nav">
				<div class="nav-hover">
					<a href="#work" class="header-link work-link" aria-haspopup="true" aria-expanded="false">Work<span class="caret"></span></a>
					<div class="nav-menu" role="menu" aria-label="作品导航">
						<a class="nav-menu-link" href="#work" role="menuitem">合集</a>
						<a class="nav-menu-link" href="#meditation" role="menuitem">冥想系列</a>
						<span class="nav-menu-divider"></span>
						<span class="nav-menu-note">更多作品即将加入…</span>
						{/* 未来新作品在此追加，例如: <a href="https://men.cgartlab.com">Men</a> / <a href="https://argus.cgartlab.com">Argus</a> */}
					</div>
				</div>
				<a href="https://cgartlab.com" class="header-link" target="_blank" rel="noopener noreferrer">Blog<span class="caret ext"></span></a>
				<a href="#profile" class="header-link">Profile</a>
				<a href="#contact" class="header-link">Contact</a>
			</nav>
			<div class="header-right">
				<button class="lang-btn" id="langToggle" type="button" aria-label="Switch language">中/En</button>
				<span class="header-sep" aria-hidden="true"></span>
				<a href={`mailto:${PERSONAL_INFO.email}`} class="header-email">hello@cgartlab.com</a>
			</div>
		</header>

		<!-- ═══ Slideshow ═══ -->
		<main id="slideshow" class="slideshow">
			<canvas id="seaweed" class="canvas-full" style="position:fixed;z-index:50;pointer-events:none"></canvas>
			<!-- Shared continuous video — one undimmed scene behind pages 3 & 4 -->
			<video id="reel" class="reel" autoplay muted loop playsinline aria-hidden="true">
				<source src="/video/demo.mp4" type="video/mp4" />
			</video>
			<!-- Fixed edge mask — permanently hides the video's hard top/bottom edges,
			     stays put while pages 3 & 4 switch (does not scroll with slides) -->
			<div id="edge-mask" aria-hidden="true"></div>
			<!-- Fixed scene layers — full-viewport backgrounds that crossfade on page
			     changes, so no hard edge ever appears between backgrounds -->
			<canvas id="grad" class="scene-layer" aria-hidden="true"></canvas>
			<canvas id="aurora" class="scene-layer" aria-hidden="true"></canvas>
			<!-- Shared silver-gray gradient scene for About & Contact (seamless) -->
			<div id="silver" class="scene-layer silver-scene" aria-hidden="true"></div>

			<!-- ═══ Slide 0 — Hero (Seaweed particles) ═══ -->
			<section class="slide dark" data-slide="0">
				<div class="slide-content center">
					<div class="hero">
						<h1 class="hero-name anim scale" data-d="0" aria-label="CHEN YANG">
							<span class="hl" aria-hidden="true"><span>C</span><span>H</span><span>E</span><span>N</span></span>
							<span class="hl" aria-hidden="true"><span>Y</span><span>A</span><span>N</span><span>G</span></span>
						</h1>
						<div class="hero-subline anim up" data-d="1">
							<p class="hero-role">A <span class="rwd" style="--ri:0"><span class="inner">Designer</span></span>, <span class="rwd" style="--ri:1"><span class="inner">Writer</span></span>, <span class="rwd" style="--ri:2"><span class="inner">Engineer</span></span>.</p>
						</div>
						<div class="hero-divider"></div>
						<p class="hero-tags anim blur" data-d="2"><span data-t="heroTag1">动态视觉设计师</span><span class="sep"> · </span><span data-t="heroTag2">内容创作者</span><span class="sep"> · </span><span data-t="heroTag3">产品工程师</span></p>
						<a href="#stats" class="scroll-cue anim up" data-d="3" aria-label="向下滚动到统计页">
							<span class="cue-label">Scroll</span>
							<span class="cue-track"><span class="cue-dot"></span></span>
						</a>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 1 — Stats (transparent: reveals fixed scene layers) ═══ -->
			<section class="slide dark" data-slide="1" id="stats">
				{/* Horizontal left→right content ticker — real cgartlab titles/excerpts, works */}
				<div class="ticker" aria-hidden="true">
					{tickerRows.map((row, i) => (
						<div
							class="ticker-row"
							style={`top:${row.top}dvh;left:${row.lx}%;width:${row.w}%;--dur:${row.dur}s;--sc:${row.sc};--bl:${row.bl}px;--op:${row.op};--ad:${row.ad}`}
						>
							<div class="ticker-track">
								{/* 24 items = 4-unit cycle × 6 → both halves identical → seamless -50%→0 loop */}
								{Array.from({ length: 24 }, (_, n) => {
									const txt = tickerItems[(i * 2 + (n % 4)) % tickerItems.length];
									return <span class="ticker-item"><span class="tw">{txt}</span><span class="ticker-sep">·</span></span>;
								})}
							</div>
						</div>
					))}
				</div>
				<div class="slide-content center">
					<div class="stats">
						<div class="stat anim up" data-d="0">
							<span class="stat-kicker" data-t="statKicker1">累计发表字数</span>
							<div class="stat-line">
								<span class="stat-value" data-target="187979">187979</span>
								<span class="stat-unit" data-t="statUnit1">字</span>
							</div>
						</div>
						<div class="stat anim up" data-d="1">
							<span class="stat-kicker" data-t="statKicker2">过去一年提交代码</span>
							<div class="stat-line">
								<span class="stat-value" data-target="5565">5565</span>
								<span class="stat-unit" data-t="statUnit2">次</span>
							</div>
						</div>
						<div class="stat anim up" data-d="2">
							<span class="stat-kicker" data-t="statKicker3">致力于数字创作领域</span>
							<div class="stat-line">
								<span class="stat-value" data-target={yearsActive}>{yearsActive}</span>
								<span class="stat-unit" data-t="statUnit3">年</span>
							</div>
						</div>
						<div class="stat anim up" data-d="3">
							<span class="stat-kicker"><span data-t="statKicker4">文章累计被浏览</span>
								{/* 数据读取点（少数派个人主页成就卡片）：#viewCount > span（当前约 89.5万+，随时间增长） */}
								<a class="stat-src" href="https://sspai.com/u/cgartlab" target="_blank" rel="noopener noreferrer" aria-label="数据来源少数派个人主页"><span data-t="statSrc">少数派</span> ↗</a>
							</span>
							<div class="stat-line">
								<span class="stat-value" data-target="89.5" data-dec="1" data-suffix="万+">89.5万+</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 2 — What I do (page 3: center → corner, video 0.5 → full) ═══ -->
			<section class="slide" data-slide="2">
				<div class="video-dim"></div>
				<div class="slide-content">
					<div class="glass" aria-hidden="true"></div>
					<div class="split">
						<div class="split-left">
							<p class="label anim up" data-d="0">What I do</p>
							<h2 class="heading-xl anim up" data-d="1"><span data-t="whatHeading">跨领域<br/>数字创作者</span></h2>
							<p class="body anim up" data-d="2">
								<span data-t="whatBody">我创建数字产品、塑造品牌视觉、分享创作背后的思考过程。倡导数据主权，坚持创作即认知的理念。</span>
							</p>
						</div>
						<div class="split-right anim right" data-d="3">
							<div class="skills">
								{SKILLS.map((category, i) => (
									<div class="skill">
										<h3 class="skill-cat">{category.category}</h3>
										<ul class="skill-list">
											{category.items.map(s => <li>{s}</li>)}
										</ul>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 3 — Featured Work (over shared reel video, text corner) ═══ -->
			<section class="slide" data-slide="3" id="work">
				<div class="slide-content">
					<div class="glass" aria-hidden="true"></div>
					<div class="work">
						<p class="label anim left" data-d="0">Featured Work</p>
						<h2 class="heading-xl anim left" data-d="1"><span data-t="workTitle">动态视觉从业十年，只有热爱，别无他解。</span></h2>
						<p class="body-lg anim up" data-d="2">
							<span data-t="workBody1">从三维动画、CG 艺术到动态视觉与数字产品，十年创作路一直在探索媒介与叙事。没有捷径可言，凭的是一点热爱与坚持——每一件作品都是对边界的试探。</span>
						</p>
						<p class="body anim up" data-d="3">
							<span data-t="workBody2">从实验性 VR 数字艺术作品《Hello World 2.0》，到品牌与发布会开场动效，再到入选 CCG EXPO 的《COVID-19》——作品在变，媒介在变，那个最初让我拿起笔的理由没有变。</span>
						</p>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 4 — Meditation (cover Ken Burns infinite, light text) ═══ -->
			<!-- ═══ Slide 5 (page 5) — Meditation: full-bleed artwork deck ═══ -->
			<section class="slide" data-slide="4" id="meditation">
				<div class="meddeck">
					{meditationImages.map((img, i) => (
						<article class="mdeck-item" data-mid={i} tabindex="0" aria-label={`${img.title} — ${img.desc}`}>
							<img class="mdeck-img" src={img.src} alt={img.title} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							<span class="mdeck-index">{(i + 1).toString().padStart(2, '0')}<em> / {meditationImages.length}</em></span>
							<div class="mdeck-hover">
								<div class="mdeck-card">
									<h3 class="mdeck-title">{img.title}</h3>
									<p class="mdeck-desc">{img.desc}</p>
								</div>
							</div>
						</article>
					))}
					{/* Final stop — all works arranged as a geometric full-bleed wall */}
					<article class="mdeck-item medwall" data-mid="-1" tabindex="0" aria-label="冥想系列 — 全部作品">
						<div class="medwall-grid">
							{meditationImages.map((img, i) => (
								<div class="medwall-cell" style={`--i:${i}`} aria-hidden="true"><img src={img.src} alt="" loading="lazy" decoding="async" /></div>
							))}
						</div>
						<div class="medwall-cap">
							<span class="medwall-eyebrow">Meditation Series</span>
							<span class="medwall-count">全部作品 · 01 – {String(meditationImages.length).padStart(2, '0')}</span>
						</div>
					</article>
				</div>
			</section>

			<!-- ═══ Slide 6 → now 5 — Profile (About) ═══ -->
			<section class="slide dark" data-slide="5" id="profile">
				<div class="slide-content scroll-y">
					<div class="profile">
						<div class="profile-left">
							<p class="label anim left" data-d="0">About</p>
							<h2 class="heading-lg anim left" data-d="1"><span data-t="aboutHeading">画画是画画的酬劳，写作是写作的回报。</span></h2>
							<p class="body anim up" data-d="2"><span data-t="aboutBody1">我是数字动态视觉出身的设计师，十余年来在设计、动画与前端之间来回穿梭。现在，我把写作当成思考的入口，把 AI 当作协作者，把每个项目都看作一次方法论的实验：慢一点比较快，先设计规则，再执行规则。</span></p>
							<p class="body anim up" data-d="3"><span data-t="aboutBody2">我相信「数据主权」与「创作即认知」——不把自己交给封闭平台，也不让想法只停在草稿里。工具会更新，软件会被淘汰，能一直带走的是想清楚的能力；CG 艺术实验室，就是我把这种能力写下来、做出来、验证过的地方。</span></p>
							<div class="profile-contact anim up" data-d="4">
								<p class="label-sm">Contact</p>
								<div class="contact-row">
									{SOCIAL_LINKS.slice(0, 4).map(link => (
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link" title={link.name} aria-label={link.name}>
											<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
										</a>
									))}
								</div>
							</div>
						</div>
						<div class="profile-right">
							<section class="psection anim right" data-d="1">
								<h3 class="label-sm" data-t="cvWork">工作经历</h3>
								{WORK_EXPERIENCE.map(exp => (
									<div class="exp">
										<span class="exp-period">{exp.period}</span>
										<div>
											<h4 class="exp-title">{exp.title}</h4>
											<p class="exp-sub">
												{exp.role}
												{exp.url && <a class="exp-link" href={exp.url} target="_blank" rel="noopener noreferrer">animpoly.com ↗</a>}
											</p>
											<p class="exp-desc">{exp.description}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim right" data-d="2">
								<h3 class="label-sm" data-t="cvEdu">教育经历</h3>
								{EDUCATION.map(edu => (
									<div class="exp">
										<span class="exp-period">{edu.period}</span>
										<div>
											<h4 class="exp-title">{edu.school}</h4>
											<p class="exp-sub">{edu.major} · {edu.degree}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim right" data-d="3">
								<h3 class="label-sm" data-t="cvProjects">项目经历与奖项认证</h3>
								{HONORS.map(h => (
									<div class="exp">
										<span class="exp-period">{h.year}</span>
										<div>
											<h4 class="exp-title">{h.title}</h4>
											<p class="exp-sub">{h.role}</p>
										</div>
									</div>
								))}
							</section>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 7 — Contact (wave particles) ═══ -->
			<section class="slide dark" data-slide="6" id="contact">
				<canvas id="waves" class="canvas-full"></canvas>
				<div class="slide-content center">
					<div class="contact">
						<p class="label anim up" data-d="0">Get in Touch</p>
						<h2 class="heading-xl anim scale" data-d="1">Let's work together</h2>
						<p class="body anim up" data-d="2"><span data-t="contactBody">如果你对我的作品感兴趣，或者有任何合作想法，欢迎随时联系我。</span></p>
						<div class="contact-actions anim up" data-d="3">
							<a href={`mailto:${PERSONAL_INFO.email}`} class="btn"><Icon name="mail" size={16} class="w-4 h-4" />{PERSONAL_INFO.email}</a>
						</div>
					</div>
				</div>
			</section>

		</main>

		<!-- ═══ Footer ═══ -->
		<footer class="footer">
			<div class="footer-divider"></div>
			<div class="footer-inner">
				<div class="footer-left">
					<span>&copy; {currentYear} ChenYang</span>
					<span class="dot">·</span>
					<span class="footer-text" data-t="footerQuote">画画是画画的酬劳，写作是写作的回报。</span>
				</div>
				<div class="footer-right">
					{SOCIAL_LINKS.map(link => (
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-link" title={link.name} aria-label={link.name}>
							<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
						</a>
					))}
				</div>
			</div>
		</footer>

		<!-- Indicator -->
		<div class="indicator"><div class="indicator-bar" id="indicator-bar"></div></div>

	</body>
</html>

<style>
/* ══════════════════════════════════════════════
   Design Tokens
══════════════════════════════════════════════ */
:root {
	--bg: #0a0a0a;
	--surface: #141414;
	--elevated: #1e1e1e;
	--text: #FAF9F6;
	--text-2: #d4d2cc;
	--text-3: #b8b8b0;
	--text-4: #b8b8b0;
	--accent: var(--ds-accent, #8A8C6E);
	--border: rgba(255,255,255,0.08);
	--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; }

/* ═══ Focus States ═══ */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ═══ Skip Link ═══ */
.skip-link { position: absolute; top: -100%; left: 1rem; z-index: 9999; padding: 0.75rem 1.5rem; background: var(--text); color: var(--bg); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: top 0.2s; }
.skip-link:focus { top: 1rem; }

/* ═══ Body ═══ */
body { background: var(--bg); color: var(--text); font-family: var(--ds-font-body, 'Outfit', 'Noto Sans SC', system-ui, sans-serif); -webkit-font-smoothing: antialiased; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }

/* ═══ Typography ═══ */
.heading-display { font-size: clamp(3rem, 10vw, 7rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 700; text-wrap: balance; }
.heading-xl { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.04em; font-weight: 700; text-wrap: balance; }
.heading-lg { font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.2; letter-spacing: -0.03em; font-weight: 600; text-wrap: balance; }
.body-lg { font-size: 1.125rem; line-height: 1.7; max-width: 65ch; }
.body { font-size: 1rem; line-height: 1.7; color: var(--text-2); max-width: 65ch; }
.body + .body { margin-top: 0.75rem; }
.body-sm { font-size: 0.875rem; line-height: 1.6; color: var(--text-3); max-width: 65ch; }
.label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); font-weight: 500; }
.label-sm { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); font-weight: 500; margin-bottom: 1rem; }

/* ═══ Header ═══ */
.header {
	position: fixed; top: 0; left: 0; right: 0; z-index: 200;
	display: flex; align-items: center; justify-content: space-between;
	padding: 1.25rem 1.5rem; pointer-events: none;
	border-bottom: 1px solid transparent;
	transition: border-color 0.3s, background 0.3s;
}
.header.scrolled { border-bottom-color: var(--border); background: rgba(10,10,10,0.8); backdrop-filter: blur(12px); }
.header > * { pointer-events: auto; }
.header-logo { font-size: 0.8rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: 0.18em; flex-shrink: 0; }
.header-nav { position: absolute; left: 50%; transform: translateX(-50%); display: flex; gap: 1.5rem; }
.header-link { font-size: 0.65rem; color: var(--text-4); text-decoration: none; text-transform: uppercase; letter-spacing: 0.12em; transition: color 0.3s; }
.header-link:hover { color: var(--text); }
.header-email { font-size: 0.65rem; color: var(--text-4); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s; }
.header-email:hover { color: var(--text); }
.header-right { display: flex; align-items: center; gap: 0; margin-left: auto; }
.header-sep { width: 1px; height: 16px; background: rgba(255,255,255,0.18); margin: 0 clamp(6px,1.5vw,12px); display: inline-block; flex-shrink: 0; }
.lang-btn { font-size: 0.65rem; letter-spacing: 0.1em; color: var(--text-4); background: none; border: none; padding: 0; cursor: pointer; transition: color 0.3s; line-height: 1.6; font-family: inherit; }
.lang-btn:hover { color: var(--text); }
html[lang="en"] .lang-btn { color: var(--accent); }
@media (max-width: 767px) { .header-email { display: none; } .header-sep { display: none; } .header-nav { gap: 0.8rem; } .header-link { font-size: 0.55rem; letter-spacing: 0.08em; } }
/* Work dropdown — hover expands to jump to each work section */
.nav-hover { position: relative; display: inline-flex; }
.caret { display: inline-block; margin-left: 0.35em; width: 0; height: 0; border-left: 3px solid transparent; border-right: 3px solid transparent; border-top: 4px solid currentColor; opacity: 0.6; transition: transform 0.25s ease; }
.nav-hover:hover .caret, .nav-hover:focus-within .caret { transform: rotate(180deg); }
/* Blog external-link caret (↗) */
.caret.ext { width: auto; height: auto; border: 0; opacity: 0.75; font-size: 0.9em; line-height: 1; transform: none; }
.caret.ext::after { content: '↗'; }
.nav-menu {
	position: absolute; top: calc(100% + 0.9rem); left: 50%; transform: translateX(-50%) translateY(6px);
	min-width: 148px; padding: 0.6rem 0; list-style: none;
	background: rgba(12,12,14,0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
	border: 1px solid var(--border); opacity: 0; visibility: hidden; pointer-events: none;
	transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
	z-index: 210;
}
.nav-hover:hover .nav-menu, .nav-hover:focus-within .nav-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); pointer-events: auto; }
.nav-menu-link {
	display: block; padding: 0.5rem 1.25rem; font-size: 0.72rem; letter-spacing: 0.08em;
	color: var(--text-2); text-decoration: none; text-transform: none; transition: background 0.2s, color 0.2s;
}
.nav-menu-link:hover, .nav-menu-link:focus-visible { background: rgba(138,140,110,0.14); color: var(--text); }
.nav-menu-divider { display: block; height: 1px; margin: 0.4rem 1.25rem; background: var(--border); }
.nav-menu-note { display: block; padding: 0.35rem 1.25rem 0.15rem; font-size: 0.6rem; color: var(--text-4); letter-spacing: 0.1em; }

/* ═══ Canvas / Video ═══ */
.canvas-full { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.bg-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block; }
.video-fixed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; z-index: 0; }
.img-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

/* Pages 3 & 4 share ONE undimmed continuous video (#reel) behind transparent slides */
.reel { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.9s ease; }
/* Fixed full-viewport scene layers — crossfade opacity on page change (no seams) */
.scene-layer { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.9s ease; display: block; }
.silver-scene { background: radial-gradient(120% 90% at 18% 8%, rgba(214,219,210,0.20) 0%, rgba(214,219,210,0.06) 34%, transparent 62%), linear-gradient(160deg, #17181d 0%, #23252c 42%, #101116 100%); }
/* Page-2 horizontal content ticker (real cgartlab text) — seamless left→right marquee
   with depth: far rows small/blurred/dim → near rows large/crisp/bright */
.ticker { position: absolute; inset: 0; overflow: hidden; z-index: 0; pointer-events: none; }
.ticker-row { position: absolute; left: var(--lx, 0%); width: var(--w, 100%); right: auto; overflow: hidden; filter: blur(var(--bl, 0px));
	-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 9%, #000 91%, transparent 100%);
	mask-image: linear-gradient(to right, transparent 0%, #000 9%, #000 91%, transparent 100%); }
.ticker-track { display: flex; width: max-content; animation: tickerR linear infinite; animation-duration: var(--dur, 12s); animation-direction: var(--ad, normal); will-change: transform; }
.ticker-item { display: inline-flex; align-items: baseline; white-space: nowrap; font-size: calc(0.82rem * var(--sc, 1)); color: var(--text-3); opacity: var(--op, 0.5); text-shadow: 0 0 14px rgba(0,0,0,0.35); }
.ticker-sep { color: var(--accent); margin: 0 clamp(0.7rem, 2vw, 1.8rem); opacity: 0.85; font-size: 0.92em; }
@keyframes tickerR { from { transform: translateX(-50%); } to { transform: none; } }
@media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }
/* About (5) & Contact (6) reveal the shared silver scene instead of flat .dark */
[data-slide="5"], [data-slide="6"] { background: transparent !important; }
/* Slide 1 reveals fixed scene layers instead of an opaque .dark background */
[data-slide="1"] { background: transparent !important; }

/* ── Page 3 (data-slide 2): center → corner, video 50% → full ── */
/* ── Page 3 (data-slide 2) choreography: center+dim(hold) → settle down → brighten ── */
/* Phase A — PERMANENT steady state: text centered on a 50%-dimmed video.
   No timer ever advances it; only real scroll movement drives phase B
   (see pg3-director JS → --pg 0..1). */
.video-dim { position: absolute; inset: 0; background: rgba(0,0,0,0.5); z-index: 0; pointer-events: none; opacity: calc(1 - var(--pg, 0)); }
.glass { position: absolute; inset: 0; background: rgba(10,10,10,0.28); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 40%, rgba(0,0,0,1) 100%); mask-image: linear-gradient(to bottom, transparent 0%, transparent 40%, rgba(0,0,0,1) 100%); z-index: 0; pointer-events: none; opacity: var(--g, 0); }
[data-slide="2"] .slide-content { position: relative; justify-content: center; align-items: center; text-align: left; padding-bottom: 0; transform: translateY(calc(var(--pg, 0) * 22vh)); }
[data-slide="2"] .slide-content::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
[data-slide="2"] .split, [data-slide="3"] .work { position: relative; z-index: 1; }

/* Gradient edges — FIXED mask over the video, independent of slide scroll */
#edge-mask {
	position: fixed; inset: 0; z-index: 120; pointer-events: none; opacity: 0;
	transition: opacity 0.6s ease;
	background:
		linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 22%, transparent 78%, rgba(0,0,0,0.6) 100%);
}
/* Page 3/4: disable per-slide edge pseudo elements entirely (mask takes over) */
[data-slide="2"]::before, [data-slide="2"]::after, [data-slide="3"]::before, [data-slide="3"]::after { content: none !important; }
/* Text shadow for readability over video */
[data-slide="2"] .split .heading-xl, [data-slide="2"] .split .body, [data-slide="2"] .split .label, [data-slide="2"] .split .skill-cat, [data-slide="2"] .split .skill-list li { text-shadow: 0 1px 3px rgba(0,0,0,0.9), 0 8px 32px rgba(0,0,0,0.55); }
/* Page 4 (data-slide 3): corner text, no dim (edges via fixed mask) */
[data-slide="3"] .slide-content { position: relative; justify-content: flex-start; align-items: flex-end; text-align: left; padding-bottom: 12dvh; }
[data-slide="3"] .work { max-width: 560px; }
[data-slide="3"] .work .heading-xl { font-size: clamp(1.9rem, 4.2vw, 3.2rem); margin: 0.5rem 0 0.9rem; }
[data-slide="3"] .work .body-lg { margin-bottom: 0.75rem; }
[data-slide="3"] .work .body { margin-bottom: 1rem; }
[data-slide="3"] .work .heading-xl, [data-slide="3"] .work .body-lg, [data-slide="3"] .work .body, [data-slide="3"] .work .label, [data-slide="3"] .work .tag { text-shadow: 0 1px 3px rgba(0,0,0,0.9), 0 8px 32px rgba(0,0,0,0.55); }
/* Page 2 — aurora gradient background + readable text scrim */
[data-slide="1"] .slide-content { position: relative; }
[data-slide="1"] .slide-content::before { content: ''; position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse 80% 70% at 50% 46%, rgba(4,4,6,0.55) 0%, rgba(4,4,6,0.2) 55%, transparent 100%); pointer-events: none; }
[data-slide="1"] .stats { position: relative; z-index: 1; }

/* ═══ Slideshow ═══ */
.slideshow { height: 100dvh; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; scrollbar-width: none; }
.slideshow::-webkit-scrollbar { display: none; }
.slide { position: relative; width: 100%; min-height: 100dvh; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; contain: layout style paint; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
/* Gradient transitions between slides — seamless background blending */
.slide::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(to bottom, transparent 0%, transparent 85%, rgba(10,10,10,0.6) 100%); transition: opacity 0.6s; }
.slide.dark::before { background: linear-gradient(to bottom, rgba(10,10,10,0.4) 0%, transparent 15%, transparent 85%, rgba(10,10,10,0.6) 100%); }
/* Top fade for slides after 0 — blend from previous */
/* Top fade for slides after 0 — blend from previous, but not too dark */
[data-slide]:not([data-slide="0"])::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 15%; z-index: 0; pointer-events: none; background: linear-gradient(to bottom, rgba(10,10,10,0.5) 0%, transparent 100%); }
.dark { background: var(--bg); }
.slide-content { position: relative; z-index: 1; display: flex; align-items: center; width: 100%; min-height: 100dvh; padding: 5rem 1.5rem; }
.slide-content.center { justify-content: center; }
.slide-content.scroll-y { align-items: flex-start; overflow-y: auto; max-height: 100dvh; }
@media (min-width: 768px) { .slide-content { padding: 5rem 3rem; } }

.center { text-align: center; }

/* ═══ Hero ═══ */
/* ═══ Hero — poster left-aligned ═══ */
[data-slide="0"] .slide-content {
	flex-direction: column;
	justify-content: flex-end;
	align-items: flex-start;
	text-align: left;
	padding-bottom: 10dvh;
}
.hero { max-width: 860px; width: 100%; }
.hero-name {
	font-size: clamp(4.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.02em;
	font-weight: 700;
	margin-bottom: 1.25rem;
	color: var(--text);
	display: flex; flex-direction: column; align-items: stretch; width: fit-content;
}
.hero-name .hl { display: flex; justify-content: space-between; width: 100%; white-space: nowrap; }
.hero-name .hl span { display: inline-block; }
.hero-subline {
	display: flex;
	align-items: baseline;
	gap: 0.6em;
	flex-wrap: wrap;
	margin-bottom: 1.25rem;
}
.hero-role {
	font-size: clamp(1.25rem, 3.2vw, 2.2rem);
	color: var(--text-3);
	letter-spacing: -0.02em;
	font-weight: 300;
}
.hero-role .rwd {
	display: inline-block;
	overflow: hidden;
	vertical-align: bottom;
}
.hero-role .rwd .inner {
	display: inline-block;
	transform: translateY(110%);
	transition: transform 0.7s var(--spring);
}
.slide.is-active .hero-role .rwd .inner {
	transform: translateY(0);
	transition-delay: calc(0.4s + var(--ri, 0) * 0.08s);
}
.hero-divider {
	width: 48px;
	height: 1px;
	background: var(--accent);
	margin-bottom: 1.25rem;
	opacity: 0;
	transform: scaleX(0);
	transform-origin: left;
	transition: opacity 0.6s var(--spring) 0.3s, transform 0.6s var(--spring) 0.3s;
}
.slide.is-active .hero-divider { opacity: 1; transform: scaleX(1); }
.hero-tags {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	justify-content: flex-start;
	gap: 0.25rem;
	font-size: 0.8125rem;
	color: var(--text-3);
	letter-spacing: 0.08em;
	text-transform: uppercase;
	margin-bottom: 2rem;
}
.hero-tags .sep { display: inline-block; color: var(--accent); margin: 0 0.65rem; opacity: 0.8; }

/* Scroll cue — replaces CTA button on the hero */
.scroll-cue { display: inline-flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 0.5rem; color: var(--text-3); text-decoration: none; }
.cue-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.3em; color: var(--text-3); transition: color 0.3s; }
.cue-track { position: relative; width: 1px; height: 44px; background: rgba(255,255,255,0.18); overflow: hidden; }
.cue-dot { position: absolute; left: 0; top: -6px; width: 1px; height: 14px; background: var(--accent); animation: cueFall 1.8s cubic-bezier(.4,0,.6,1) infinite; }
.scroll-cue:hover .cue-label { color: var(--text); }
.scroll-cue:hover .cue-dot { background: var(--text-2); }
@keyframes cueFall { 0% { transform: translateY(0); opacity: 0; } 25% { opacity: 1; } 70% { opacity: 1; } 100% { transform: translateY(46px); opacity: 0; } }

/* ═══ Stats ═══ */
.stats { width: 100%; max-width: 1080px; display: grid; grid-template-columns: 1fr; gap: 0; margin: 0 auto; transform: translate(1.2vw, -4dvh); }
@media (max-width: 768px) { .stats { transform: translate(0.6vw, -2dvh); } }
@media (min-width: 768px) { .stats { grid-template-columns: repeat(2, 1fr); } }
.stat {
	display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem;
	padding: 2rem 1.5rem; border-bottom: 1px solid var(--border); position: relative; z-index: 1;
}
@media (min-width: 768px) {
	.stat { padding: 2.75rem 2.25rem; border-right: 1px solid var(--border); }
	.stat:nth-child(2n) { border-right: 0; }
	.stat:nth-last-child(-n+2) { border-bottom: 0; }
}
.stat-kicker { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--text-3); }
.stat-src { display: inline-block; margin-left: 0.55rem; padding: 1px 7px; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: none; color: var(--text-4); border: 1px solid var(--border); border-radius: 999px; vertical-align: middle; text-decoration: none; transition: color 0.3s, border-color 0.3s; }
.stat-src:hover { color: var(--text); border-color: var(--text-4); }
.stat-line { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
.stat-value { font-size: clamp(3rem, 8vw, 6.5rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
.stat-unit { font-size: 1rem; color: var(--accent); font-weight: 500; }
@media (min-width: 768px) {
	.stat:nth-child(1) { border-top: 1px solid var(--border); }
	.stat:nth-child(2) { border-top: 1px solid var(--border); }
}

/* ═══ Split ═══ */
.split { display: grid; grid-template-columns: 1fr; gap: 2.5rem; width: 100%; }
@media (min-width: 1024px) { .split { grid-template-columns: 5fr 7fr; gap: 4rem; } }
.split-left { max-width: 480px; }
.split-left .heading-xl { margin-bottom: 1rem; }
.skills { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.skill-cat { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); margin-bottom: 0.75rem; }
.skill-list { list-style: none; padding: 0; }
.skill-list li { font-size: 0.875rem; color: var(--text-2); line-height: 1.8; }

/* ═══ Work ═══ */
.work { max-width: 640px; }
.work .heading-xl { margin: 0.5rem 0 1rem; }
.work .body-lg { color: var(--text-2); margin-bottom: 1rem; }
.work .body { margin-bottom: 1.5rem; }
.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tag { padding: 4px 12px; font-size: 0.7rem; background: rgba(255,255,255,0.06); color: var(--text-3); border: 1px solid var(--border); transition: transform 0.3s var(--spring), color 0.3s, background 0.3s; }
.tag:hover { background: rgba(255,255,255,0.1); color: var(--text); border-color: rgba(255,255,255,0.15); }

/* ═══ Meditation ═══ */
/* Meditation: Ken Burns infinite background */
.kb-stage { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
.kb-img {
	position: absolute; inset: -12%;
	width: 124%; height: 124%;
	object-fit: cover;
	filter: brightness(0.45);
	animation: kenburns 24s ease-in-out infinite alternate;
	will-change: transform;
}
.kb-overlay {
	position: absolute; inset: 0;
	background: linear-gradient(180deg, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.15) 40%, rgba(10,10,10,0.7) 100%);
}
@keyframes kenburns {
	0% { transform: scale(1) translate(0, 0); }
	25% { transform: scale(1.08) translate(-2%, 1%); }
	50% { transform: scale(1.12) translate(1.5%, -1%); }
	75% { transform: scale(1.06) translate(-1%, -2%); }
	100% { transform: scale(1.1) translate(2%, 1.5%); }
}
.med-text-center {
	max-width: 560px;
	margin-left: auto;
	text-align: center;
	padding: 2rem 1.5rem;
	background: rgba(10,10,10,0.55);
	backdrop-filter: blur(6px);
	border: 1px solid var(--border);
}
.med-text-center .heading-display { margin: 0.5rem 0 1rem; }
.med-text-center .body { margin-bottom: 1.5rem; }
.med-cta { display: flex; justify-content: center; }

/* ═══ Meditation — full-bleed artwork deck ═══ */
.meddeck { width: 100%; }
.mdeck-item {
	position: relative; height: 100dvh; overflow: hidden;
	scroll-snap-align: start; scroll-snap-stop: always;
	display: flex; align-items: center; justify-content: center;
	background: var(--bg);
}
.mdeck-img {
	position: absolute; inset: 0; width: 100%; height: 100%;
	object-fit: cover; filter: brightness(0.6);
	transform: scale(1.09);
	transition: transform 1.2s cubic-bezier(.16,1,.3,1), filter 0.5s ease;
}
.mdeck-item.cur .mdeck-img { transform: scale(1); }
.mdeck-item:hover .mdeck-img { filter: brightness(0.75); }
/* always-visible index — small, fixed top-right of the artwork */
.mdeck-index {
	position: absolute; top: max(4.5rem, env(safe-area-inset-top)); right: 1.25rem;
	font-size: 0.55rem; letter-spacing: 0.14em; color: var(--text-3);
	font-variant-numeric: tabular-nums; text-shadow: 0 1px 6px rgba(0,0,0,0.8);
	z-index: 2; pointer-events: none;
}
.mdeck-index em { font-style: normal; font-size: 0.9em; color: var(--text-4); margin-left: 0.5em; }
/* hover: intro text anchors BOTTOM-LEFT, plain text (no card) */
.mdeck-hover {
	position: absolute; left: clamp(1.5rem, 6vw, 4rem); top: auto; right: auto;
	bottom: max(9dvh, calc(env(safe-area-inset-bottom) + 2.5rem));
