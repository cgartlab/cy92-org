---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, PERSONAL_INFO, SKILLS, EXPERIENCE, SOCIAL_LINKS, HONORS, WORK_EXPERIENCE, EDUCATION } from '../consts';

const coverImage = '/images/冥想系列-cover.webp';
const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 2014;
const meditationImages = [
	{ src: '/images/冥想系列-1754664750528.webp', title: '冥想系列 1', desc: '早期冥想探索，意识的初次解剖' },
	{ src: '/images/冥想系列-1754664757458.webp', title: '冥想系列 2', desc: '内心对话，矛盾与冲突的视觉化' },
	{ src: '/images/冥想系列-1754664764581.webp', title: '冥想系列 3', desc: '繁重压迫下的精神释放' },
	{ src: '/images/冥想系列-1754664772045.webp', title: '冥想系列 4', desc: '对立统一，真实的自我映射' },
	{ src: '/images/冥想系列-1754664780351.webp', title: '冥想系列 5', desc: '意识深处的宁静与动荡' },
	{ src: '/images/冥想系列-1754664786331.webp', title: '冥想系列 6', desc: '精神世界的数字重构' },
	{ src: '/images/冥想系列-1754664798635.webp', title: '冥想系列 7', desc: '内在探索的第七阶段' },
	{ src: '/images/冥想系列-1754664814920.webp', title: '冥想系列 8', desc: '接近实相的道路' },
	{ src: '/images/冥想系列-1754664822895.webp', title: '冥想系列 9', desc: '意识的最终形态' },
	{ src: '/images/冥想系列-1754664829706.webp', title: '冥想系列 10', desc: '冥想之旅的终点与起点' }
];
---

<!doctype html>
<html lang="zh-CN" style="color-scheme:dark">
	<head>
		<BaseHead title={SITE_TITLE} description={PERSONAL_INFO.description} />
	</head>
	<body>

	<a href="#slideshow" class="skip-link">跳到主内容</a>

		<!-- ═══ Immersive Header ═══ -->
		<header class="header" id="header">
			<a href="/" class="header-logo">{SITE_TITLE.split(' | ')[0]}</a>
			<nav class="header-nav">
				<a href="#work" class="header-link">Work</a>
				<a href="#profile" class="header-link">Profile</a>
				<a href="#contact" class="header-link">Contact</a>
			</nav>
			<a href={`mailto:${PERSONAL_INFO.email}`} class="header-email">hello@cgartlab.com</a>
		</header>

		<!-- ═══ Slideshow ═══ -->
		<main id="slideshow" class="slideshow">
			<canvas id="seaweed" class="canvas-full" style="position:fixed;z-index:50"></canvas>

			<!-- ═══ Slide 0 — Hero (Seaweed particles) ═══ -->
			<section class="slide dark" data-slide="0">
				<div class="slide-content center">
					<div class="hero">
						<h1 class="hero-name anim scale" data-d="0">CHEN<br>YANG</h1>
						<div class="hero-subline anim up" data-d="1">
							<p class="hero-role">A <span class="rwd" style="--ri:0"><span class="inner">Designer</span></span>, <span class="rwd" style="--ri:1"><span class="inner">Writer</span></span>, <span class="rwd" style="--ri:2"><span class="inner">Engineer</span></span>.</p>
						</div>
						<div class="hero-divider"></div>
						<p class="hero-tags anim blur" data-d="2">动态视觉设计师<span class="sep"> · </span>内容创作者<span class="sep"> · </span>产品工程师</p>
						<a href="#work" class="btn anim up" data-d="3">探索作品 <Icon name="arrow_downward" size={16} class="w-4 h-4" /></a>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 1 — Stats ═══ -->
			<section class="slide dark" data-slide="1">
				<div class="slide-content center">
					<div class="stats">
						<div class="stat anim right" data-d="0">
							<span class="stat-label">累计发表字数</span>
							<span class="stat-value" data-target="187979">187,979</span>
							<span class="stat-unit">字</span>
						</div>
						<div class="stat anim right" data-d="1">
							<span class="stat-label">过去一年提交代码</span>
							<span class="stat-value" data-target="5565">5,565</span>
							<span class="stat-unit">次</span>
						</div>
						<div class="stat anim right" data-d="2">
							<span class="stat-label">致力于数字创作领域</span>
							<span class="stat-value" data-target={yearsActive}>{yearsActive}</span>
							<span class="stat-unit">年</span>
						</div>
						<div class="stat anim right" data-d="3">
							<span class="stat-label">跨领域专业项目</span>
							<span class="stat-value" data-target="50" data-suffix="+">50+</span>
							<span class="stat-unit">个</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 2 — What I do (video bg -30%, fixed) ═══ -->
			<section class="slide" data-slide="2">
				<video id="shared-video" autoplay muted loop playsinline class="video-fixed" style="filter:brightness(0.45)">
					<source src="/video/demo.mp4" type="video/mp4" />
				</video>
				<div class="slide-content">
					<div class="split">
						<div class="split-left">
							<p class="label anim left" data-d="0">What I do</p>
							<h2 class="heading-xl anim left" data-d="1">跨领域<br>数字创作者</h2>
							<p class="body anim up" data-d="2">
								我创建数字产品、塑造品牌视觉、分享创作背后的思考过程。倡导数据主权，坚持创作即认知的理念。
							</p>
						</div>
						<div class="split-right">
							<div class="skills">
								{SKILLS.map((category, i) => (
									<div class="skill anim right" data-d={i + 2}>
										<h3 class="skill-cat">{category.category}</h3>
										<ul class="skill-list">
											{category.items.map(s => <li>{s}</li>)}
										</ul>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 3 — Featured Work (video bg +70%, light text) ═══ -->
			<section class="slide" data-slide="3" id="work">
				<video autoplay muted loop playsinline class="video-fixed" style="filter:brightness(0.7)">
					<source src="/video/demo.mp4" type="video/mp4" />
				</video>
				<div class="slide-content">
					<div class="work">
						<p class="label anim left" data-d="0">Featured Work</p>
						<h2 class="heading-xl anim left" data-d="1">本科动画毕业十年后的作品集</h2>
						<p class="body-lg anim up" data-d="2">
							四年一度的作品集更新，涵盖三维动画、CG艺术、手绘等多种创作形式。展示了从2016年毕业至今的创作历程与艺术探索，记录了从学生到职业创作者的完整转变。
						</p>
						<p class="body anim up" data-d="3">
							从早期的实验性VR数字艺术作品《Hello World 2.0》，到为央视《2025 CCTV品牌强国工程发布会》制作的开场片动效，再到入选CCG EXPO的《COVID-19》——每一件作品都是对创作边界的探索与突破。
						</p>
						<div class="tags anim up" data-d="4">
							<span class="tag">2024</span>
							<span class="tag">三维动画</span>
							<span class="tag">CG艺术</span>
							<span class="tag">作品集</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 4 — Meditation (cover Ken Burns infinite, light text) ═══ -->
			<section class="slide" data-slide="4">
				<!-- Infinite Ken Burns loop background -->
				<div class="kb-stage">
					<img src={coverImage} alt="冥想系列" class="kb-img" />
					<div class="kb-overlay"></div>
				</div>
				<div class="slide-content">
					<div class="med-text-center">
						<p class="label anim up" data-d="0">Meditation Series</p>
						<h2 class="heading-display anim up" data-d="1">冥想系列</h2>
						<p class="body anim up" data-d="2">
							冥想是一种改变意识的形式，是解剖自己内心的过程。在接下来的几年里我用自己的业余时间创作了这个系列，每一幅作品都聊到了我经历的不同阶段，每个阶段我选择不同的主题与自己的内心交谈。
						</p>
						<div class="med-cta anim up" data-d="3">
							<a href="https://cgartlab.com/posts/meditation-series/" target="_blank" rel="noopener noreferrer" class="btn">
								查看全部作品 <Icon name="arrow_forward" size={16} class="w-4 h-4" />
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 5 — Gallery 3D ═══ -->
			<section class="slide dark" data-slide="5">
				<div class="slide-content center">
					<div class="gallery-wrap">
						<p class="label anim up" data-d="0" style="text-align:center">Gallery</p>
						<div class="gallery-3d">
							{meditationImages.map((img, i) => (
								<div class="gcard anim up" data-d={i % 5} style={`--i:${i}`}>
									<img src={img.src} alt={img.title} width="220" height="280" loading="lazy" decoding="async" class="gcard-img" />
									<div class="gcard-info">
										<h3 class="gcard-title">{img.title}</h3>
										<p class="gcard-desc">{img.desc}</p>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 6 — Profile (mobile optimized) ═══ -->
			<section class="slide dark" data-slide="6" id="profile">
				<div class="slide-content scroll-y">
					<div class="profile">
						<div class="profile-left">
							<p class="label anim left" data-d="0">About</p>
							<h2 class="heading-lg anim left" data-d="1">画画是画画的酬劳，写作是写作的回报。</h2>
							<p class="body anim up" data-d="2">INFJ型人格，目前居住在云南昆明。倡导数据主权，坚持创作即认知的理念。</p>
							<p class="body anim up" data-d="3">「数据主权」是我价值体系的核心。「创作即认知」——写作的根本目的在于梳理思维、认识自我。</p>
							<div class="profile-contact anim up" data-d="4">
								<p class="label-sm">Contact</p>
								<div class="contact-row">
									{SOCIAL_LINKS.slice(0, 4).map(link => (
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link" title={link.name} aria-label={link.name}>
											<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
										</a>
									))}
								</div>
							</div>
						</div>
						<div class="profile-right">
							<section class="psection anim right" data-d="1">
								<h3 class="label-sm">工作经历</h3>
								{WORK_EXPERIENCE.map(exp => (
									<div class="exp">
										<span class="exp-period">{exp.period}</span>
										<div>
											<h4 class="exp-title">{exp.title}</h4>
											<p class="exp-desc">{exp.description}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim right" data-d="2">
								<h3 class="label-sm">教育经历</h3>
								{EDUCATION.map(edu => (
									<div class="exp">
										<span class="exp-period">{edu.period}</span>
										<div>
											<h4 class="exp-title">{edu.school}</h4>
											<p class="exp-accent">{edu.major}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim right" data-d="3">
								<h3 class="label-sm">Honors</h3>
								<div class="honors">
									{HONORS.slice(0, 4).map(h => (
										<div class="honor">
											<span class="honor-year">{h.year}</span>
											<h4 class="honor-title">{h.title}</h4>
										</div>
									))}
								</div>
							</section>
							<section class="psection anim right" data-d="4">
								<h3 class="label-sm">Creative Practice</h3>
								<div class="practice">
									{EXPERIENCE.map(exp => (
										<div class="practice-card">
											<span class="practice-period">{exp.period}</span>
											<h4 class="practice-title">{exp.title}</h4>
											<p class="practice-desc">{exp.description}</p>
										</div>
									))}
								</div>
							</section>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 7 — Contact (wave particles) ═══ -->
			<section class="slide dark" data-slide="7" id="contact">
				<canvas id="waves" class="canvas-full"></canvas>
				<div class="slide-content center">
					<div class="contact">
						<p class="label anim up" data-d="0">Get in Touch</p>
						<h2 class="heading-xl anim scale" data-d="1">Let's work together</h2>
						<p class="body anim up" data-d="2">如果你对我的作品感兴趣，或者有任何合作想法，欢迎随时联系我。</p>
						<div class="contact-actions anim up" data-d="3">
							<a href={`mailto:${PERSONAL_INFO.email}`} class="btn"><Icon name="mail" size={16} class="w-4 h-4" />{PERSONAL_INFO.email}</a>
							{SOCIAL_LINKS.slice(0, 4).map(link => (
								<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link-lg" title={link.name} aria-label={link.name}>
									<Icon name={link.icon} size={16} class="w-4 h-4" fill />
								</a>
							))}
						</div>
					</div>
				</div>
			</section>

		</main>

		<!-- ═══ Footer ═══ -->
		<footer class="footer">
			<div class="footer-divider"></div>
			<div class="footer-inner">
				<div class="footer-left">
					<span>&copy; {currentYear} ChenYang</span>
					<span class="dot">·</span>
					<span class="footer-text">画画是画画的酬劳，写作是写作的回报。</span>
				</div>
				<div class="footer-right">
					{SOCIAL_LINKS.map(link => (
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-link" title={link.name} aria-label={link.name}>
							<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
						</a>
					))}
				</div>
			</div>
		</footer>

		<!-- Indicator -->
		<div class="indicator"><div class="indicator-bar" id="indicator-bar"></div></div>

	</body>
</html>

<style>
/* ══════════════════════════════════════════════
   Design Tokens
══════════════════════════════════════════════ */
:root {
	--bg: #0a0a0a;
	--surface: #141414;
	--elevated: #1e1e1e;
	--text: #FAF9F6;
	--text-2: #d4d2cc;
	--text-3: #b8b8b0;
	--text-4: #9a9a92;
	--accent: var(--ds-accent, #8A8C6E);
	--border: rgba(255,255,255,0.08);
	--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; }

/* ═══ Focus States ═══ */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* ═══ Skip Link ═══ */
.skip-link { position: absolute; top: -100%; left: 1rem; z-index: 9999; padding: 0.75rem 1.5rem; background: var(--text); color: var(--bg); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: top 0.2s; }
.skip-link:focus { top: 1rem; }

/* ═══ Body ═══ */
body { background: var(--bg); color: var(--text); font-family: var(--ds-font-body, 'Outfit', 'Noto Sans SC', system-ui, sans-serif); -webkit-font-smoothing: antialiased; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }

/* ═══ Typography ═══ */
.heading-display { font-size: clamp(3rem, 10vw, 7rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 700; text-wrap: balance; }
.heading-xl { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.04em; font-weight: 700; text-wrap: balance; }
.heading-lg { font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.2; letter-spacing: -0.03em; font-weight: 600; text-wrap: balance; }
.body-lg { font-size: 1.125rem; line-height: 1.7; max-width: 65ch; }
.body { font-size: 1rem; line-height: 1.7; color: var(--text-2); max-width: 65ch; }
.body + .body { margin-top: 0.75rem; }
.body-sm { font-size: 0.875rem; line-height: 1.6; color: var(--text-3); max-width: 65ch; }
.label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); font-weight: 500; }
.label-sm { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); font-weight: 500; margin-bottom: 1rem; }

/* ═══ Header ═══ */
.header {
	position: fixed; top: 0; left: 0; right: 0; z-index: 200;
	display: flex; align-items: center; justify-content: space-between;
	padding: 1.25rem 1.5rem; pointer-events: none;
	border-bottom: 1px solid transparent;
	transition: border-color 0.3s, background 0.3s;
}
.header.scrolled { border-bottom-color: var(--border); background: rgba(10,10,10,0.8); backdrop-filter: blur(12px); }
.header > * { pointer-events: auto; }
.header-logo { font-size: 0.875rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: -0.02em; }
.header-nav { display: flex; gap: 1.5rem; }
.header-link { font-size: 0.65rem; color: var(--text-4); text-decoration: none; text-transform: uppercase; letter-spacing: 0.12em; transition: color 0.3s; }
.header-link:hover { color: var(--text); }
.header-email { font-size: 0.65rem; color: var(--text-4); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s; }
.header-email:hover { color: var(--text); }
@media (max-width: 767px) { .header-email { display: none; } }

/* ═══ Canvas / Video ═══ */
.canvas-full { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.video-fixed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; z-index: 0; }
.img-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

/* Slide 3 text scrim — prevent text unreadable on bright video areas */
[data-slide="3"] .slide-content { position: relative; }
[data-slide="3"] .slide-content::before { content: ''; position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(10,10,10,0.65) 0%, rgba(10,10,10,0.25) 60%, transparent 100%); pointer-events: none; }
[data-slide="3"] .work { position: relative; z-index: 1; }

/* ═══ Slideshow ═══ */
.slideshow { height: 100dvh; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; scrollbar-width: none; }
.slideshow::-webkit-scrollbar { display: none; }
.slide { position: relative; width: 100%; min-height: 100dvh; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; contain: layout style paint; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
/* Gradient transitions between slides — seamless background blending */
.slide::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(to bottom, transparent 0%, transparent 85%, rgba(10,10,10,0.6) 100%); transition: opacity 0.6s; }
.slide.dark::before { background: linear-gradient(to bottom, rgba(10,10,10,0.4) 0%, transparent 15%, transparent 85%, rgba(10,10,10,0.6) 100%); }
/* Top fade for slides after 0 — blend from previous */
[data-slide="1"]::after, [data-slide="2"]::after, [data-slide="3"]::after, [data-slide="4"]::after, [data-slide="5"]::after, [data-slide="6"]::after, [data-slide="7"]::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 20%; z-index: 0; pointer-events: none; background: linear-gradient(to bottom, rgba(10,10,10,0.8) 0%, transparent 100%); }
.dark { background: var(--bg); }
.slide-content { position: relative; z-index: 1; display: flex; align-items: center; width: 100%; min-height: 100dvh; padding: 5rem 1.5rem; }
.slide-content.center { justify-content: center; }
.slide-content.scroll-y { align-items: flex-start; overflow-y: auto; max-height: 100dvh; }
@media (min-width: 768px) { .slide-content { padding: 5rem 3rem; } }

.center { text-align: center; }

/* ═══ Hero ═══ */
/* ═══ Hero — poster left-aligned ═══ */
[data-slide="0"] .slide-content {
	flex-direction: column;
	justify-content: flex-end;
	align-items: flex-start;
	text-align: left;
	padding-bottom: 10dvh;
}
.hero { max-width: 860px; width: 100%; }
.hero-name {
	font-size: clamp(4.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.06em;
	font-weight: 700;
	margin-bottom: 1.25rem;
	color: var(--text);
}
.hero-subline {
	display: flex;
	align-items: baseline;
	gap: 0.6em;
	flex-wrap: wrap;
	margin-bottom: 1.25rem;
}
.hero-role {
	font-size: clamp(1.25rem, 3.2vw, 2.2rem);
	color: var(--text-3);
	letter-spacing: -0.02em;
	font-weight: 300;
}
.hero-role .rwd {
	display: inline-block;
	overflow: hidden;
	vertical-align: bottom;
}
