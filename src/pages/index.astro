	let t = Math.random() * 60;
	const draw = () => {
		requestAnimationFrame(draw);
		fade += ((activeNow ? 1 : 0) - fade) * 0.06;
		if (fade < 0.015 && !activeNow) return; // idle off-screen
		ctx.clearRect(0, 0, w, h);
		ctx.globalAlpha = fade;
		ctx.fillStyle = '#000';
		ctx.fillRect(0, 0, w, h);
		t += 0.008;
		ctx.globalCompositeOperation = 'lighter';
		for (let i = 0; i < blobs.length; i++) {
			const b = blobs[i];
			const bx = w * (0.5 + 0.46 * Math.sin(t * b.fx + b.ph));
			const by = h * (0.5 + 0.44 * Math.cos(t * b.fy + b.ph2));
			const R = base * b.r * (1 + 0.16 * Math.sin(t * 0.5 + b.ph));
			const g = ctx.createRadialGradient(bx, by, 0, bx, by, R);
			g.addColorStop(0, 'rgba(' + b.c + ',' + b.a + ')');
			g.addColorStop(0.5, 'rgba(' + b.c + ',' + (b.a * 0.5) + ')');
			g.addColorStop(1, 'rgba(' + b.c + ',0)');
			ctx.fillStyle = g;
			ctx.fillRect(bx - R, by - R, R * 2, R * 2);
		}
		ctx.globalCompositeOperation = 'source-over';
		// Edge blend for seamless page transitions
		const vg = ctx.createLinearGradient(0, 0, 0, h);
		vg.addColorStop(0, 'rgba(6,6,8,' + (0.75 * fade) + ')');
		vg.addColorStop(0.2, 'rgba(6,6,8,0)');
		vg.addColorStop(0.8, 'rgba(6,6,8,0)');
		vg.addColorStop(1, 'rgba(6,6,8,' + (0.75 * fade) + ')');
		ctx.fillStyle = vg;
		ctx.fillRect(0, 0, w, h);
		ctx.globalAlpha = 1;
	};
	draw();
})(); } catch(e) { console.warn('[grad]', e.message); }



// ═══ Meditation deck — full-screen artworks: entrance zoom + hover float card ═══
try { (() => {
	const items = document.querySelectorAll('.mdeck-item');
	if (!items.length) return;
	const io = new IntersectionObserver(es => {
		es.forEach(e => { e.target.classList.toggle('cur', e.isIntersecting); });
	}, { threshold: 0.55 });
	items.forEach(it => io.observe(it));
})(); } catch(e) { console.warn('[meddeck]', e.message); }


// ═══ Page-3 director: Phase A is steady (centered text, dim video). Only
// real scroll movement toward page 4 drives settle (--pg) and brighten/glass (--g). ═══
try { (() => {
	const sc = document.getElementById('slideshow');
	const slide = document.querySelector('[data-slide="2"]');
	const next = document.querySelector('[data-slide="3"]');
	if (!sc || !slide || !next) return;
	if (matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
	let raf = 0, a0 = 0, span = 1;
	const rectTop = el => el.getBoundingClientRect().top + sc.scrollTop;
	const measure = () => { a0 = rectTop(slide); span = Math.max(1, rectTop(next) - a0); };
	const apply = () => {
		raf = 0;
		const p = Math.min(1, Math.max(0, (sc.scrollTop - a0) / span));
		const g = p <= 0.3 ? 0 : p >= 1 ? 1 : (p - 0.3) / 0.7;
		slide.style.setProperty('--pg', String(p));
		slide.style.setProperty('--g', String(g));
	};
	const onScroll = () => { if (!raf) raf = requestAnimationFrame(apply); };
	sc.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', () => { measure(); onScroll(); }, { passive: true });
	measure(); apply();
})(); } catch(e) { console.warn('[pg3]', e.message); }


// ═══ Slide observer — active page = the slide under the deck's vertical center.
// (IntersectionRatio>0.5 broke for the tall meditation deck: a 11-stop slide only
// ever shows ~9% of its height, so it could never become active.) ═══
try { (() => {
	const sl = document.getElementById('slideshow');
	const ss = Array.from(document.querySelectorAll('.slide'));
	const ib = document.getElementById('indicator-bar');
	const header = document.getElementById('header');
	const reel = document.getElementById('reel');
	const edgeMask = document.getElementById('edge-mask');
	const grad = document.getElementById('grad');
	const rainCv = document.getElementById('aurora');
	const silver = document.getElementById('silver');
	if (!sl || !ss.length) return;
	const r = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	if (r) { ss.forEach(s => s.classList.add('is-active')); return; }

	let curIdx = -1, raf = 0;
	const tops = [], heights = [];
	const measure = () => {
		for (let k = 0; k < ss.length; k++) {
			tops[k] = ss[k].getBoundingClientRect().top + sl.scrollTop;
			heights[k] = ss[k].offsetHeight;
		}
	};
	const apply = () => {
		raf = 0;
		measure();
		const center = sl.scrollTop + sl.clientHeight / 2;
		let cur = ss.length - 1;
		for (let k = 0; k < ss.length; k++) {
			if (center >= tops[k] && center < tops[k] + heights[k]) { cur = k; break; }
		}
		if (cur === curIdx) return;
		curIdx = cur;
		sl.dataset.active = String(cur);
		// notify feature scripts (e.g., stats count-up) when entering page 2 (idx 1)
		sl.dispatchEvent(new CustomEvent('deckact', { detail: cur }));
		ss.forEach((s, k) => s.classList.toggle('is-active', k === cur));
		if (ib) ib.style.transform = 'scaleY(' + ((cur + 1) / ss.length) + ')';
		if (header) header.classList.toggle('scrolled', cur > 0);
		if (reel) { reel.style.opacity = (cur === 2 || cur === 3) ? '1' : '0'; reel.style.filter = (cur === 2 || cur === 3) ? 'brightness(1)' : ''; }
		if (edgeMask) edgeMask.style.opacity = (cur === 2 || cur === 3) ? '1' : '0';
		if (grad) grad.style.opacity = (cur === 1) ? '1' : '0';
		if (rainCv) rainCv.style.opacity = (cur === 1) ? '1' : '0';
		if (silver) silver.style.opacity = (cur === 5 || cur === 6) ? '1' : '0';
	};
	const onScroll = () => { if (!raf) raf = requestAnimationFrame(apply); };
	sl.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', onScroll, { passive: true });
	window.addEventListener('load', onScroll);
	ss[0]?.classList.add('is-active');
	apply();
})(); } catch(e) { console.warn("[2]", e.message); }

// ═══ Number counter — count-up entrance driven by page activation (replays on re-entry) ═══
try { (() => {
	const els = Array.from(document.querySelectorAll('.stat-value[data-target]'));
	if (!els.length) return;
	const reduce = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	const rafMap = new Map();
	const parse = el => { const v = parseFloat(el.dataset.target || '0'); const d = parseInt(el.dataset.dec || '0', 10) || 0; return { v: v || 0, d }; };
	const fmt = (el, n) => { const d = parseInt(el.dataset.dec || '0', 10) || 0; return d ? n.toFixed(d) : String(n); };
	const suffixOf = el => el.dataset.suffix || (el.textContent.includes('+') ? '+' : '');
	const animate = el => {
		if (reduce) { const { v, d } = parse(el); el.textContent = (d ? v.toFixed(d) : String(Math.round(v))) + suffixOf(el); return; }
		const prev = rafMap.get(el); if (prev) cancelAnimationFrame(prev);
		const { v: target, d } = parse(el);
		const dur = 800, start = performance.now();
		const tick = now => {
			const p = Math.min((now - start) / dur, 1);
			const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic — quick, gentle
			if (p >= 1) {
				el.textContent = fmt(el, target) + suffixOf(el);
				rafMap.delete(el);
			} else if (d) {
				// mid-run: integers only (no 12.3万+ noise); decimals reveal at the end
				el.textContent = String(Math.round(target * eased)) + suffixOf(el);
				rafMap.set(el, requestAnimationFrame(tick));
			} else {
				// large integers: quantized jumps so the digits don't crawl forever
				const step = Math.max(1, Math.round(target / 26));
				el.textContent = String(Math.min(target, Math.round(target * eased / step) * step)) + suffixOf(el);
				rafMap.set(el, requestAnimationFrame(tick));
			}
		};
		rafMap.set(el, requestAnimationFrame(tick));
	};
	const runAll = () => els.forEach(animate);
	const deck = document.getElementById('slideshow');
	if (deck) deck.addEventListener('deckact', e => { if (e.detail === 1) runAll(); });
	// Fallback trigger when the stat values scroll into view (hash nav / direct)
	const io = new IntersectionObserver(es => { es.forEach(en => { if (en.isIntersecting) animate(en.target); }); }, { threshold: 0.2 });
	els.forEach(el => io.observe(el));
})(); } catch(e) { console.warn("[3]", e.message); }

// ═══ Gallery 3D tilt ═══
try { (() => {
	const cards = document.querySelectorAll('.gcard');
	if (!cards.length || matchMedia?.('(prefers-reduced-motion: reduce)').matches || matchMedia?.('(pointer: coarse)').matches) return;
	cards.forEach(card => {
		card.addEventListener('mousemove', e => {
			const r = card.getBoundingClientRect();
			const px = (e.clientX - r.left) / r.width - 0.5; // -0.5 .. 0.5
			const py = (e.clientY - r.top) / r.height - 0.5;
			card.style.setProperty('--ry', (px * 14).toFixed(2) + 'deg');
			card.style.setProperty('--rx', (-py * 12).toFixed(2) + 'deg');
			card.classList.add('tilting');
		});
		card.addEventListener('mouseleave', () => {
			card.classList.remove('tilting');
		});
	});
})(); } catch(e) { console.warn("[4]", e.message); }

// ═══ Smooth anchor ═══
try { (() => {
	document.querySelectorAll('a[href^="#"]').forEach(a => {
		a.addEventListener('click', e => {
			e.preventDefault();
			const href = a.getAttribute('href');
			const t = document.querySelector(href);
			if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
})(); } catch(e) { console.warn('[anchor]', e.message); }

// ═══ Language toggle ═══
document.getElementById('langToggle')?.addEventListener('click', () => {
  switchLang(currentLang === 'zh' ? 'en' : 'zh');
});

// ═══ Keyboard navigation — ArrowDown / Space → next slide, ArrowUp → prev ═══
document.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
  const deck = document.getElementById('slideshow');
  if (!deck) return;
  const dir = e.key === 'ArrowDown' || e.key === ' ' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
  if (!dir) return;
  e.preventDefault();
  deck.scrollBy({ top: dir * window.innerHeight, behavior: 'smooth' });
});

</script>
