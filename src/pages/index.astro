<script>
// ═══ Seaweed — large kelp (60fps optimized) ═══
try { (() => {
	const c = document.getElementById('seaweed');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const layers = [[], [], []];
	let mx = -9999, my = -9999;
	const GLOW_R = 280, GLOW_R2 = GLOW_R * GLOW_R;
	const PUSH_R = 420, PUSH_R2 = PUSH_R * PUSH_R, PUSH_K = 75;
	const DEPTH_W = [4.5, 1.0, 0];
	const DEPTH_A = [0.025, 0.065, 0.13];
	const rays = [], snow = [], codeCols = [];
	const CHARS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789ABCDEF';

	const build = () => {
		layers[0].length = 0; layers[1].length = 0; layers[2].length = 0;
		const n = Math.max(40, Math.floor(w / 26));
		for (let i = 0; i < n; i++) {
			const t = i / n;
			const li = t < 0.33 ? 0 : t < 0.66 ? 1 : 2;
			const numPts = li === 0 ? 8 + Math.floor(Math.random() * 3) : 10 + Math.floor(Math.random() * 5);
			const nM1 = numPts - 1;
			const inv = 1 / nM1;
			const hue = 65 + Math.random() * 35;
			const alpha = DEPTH_A[li] + Math.random() * 0.03;
			const lw = DEPTH_W[li] + [0.4, 1.0, 2.0][li] + Math.random() * 0.7;
			const k = {
				baseX: t * w + (Math.random() - 0.5) * 50,
				hue, alpha, w: lw,
				speed: 0.2 + Math.random() * 0.3,
				phase: Math.random() * 6.28,
				amp: 25 + Math.random() * 40,
				numPts, invN: inv,
				pts: Array.from({ length: numPts }, () => ({ y: 0, off: Math.random() * 6.28 })),
				illum: new Float32Array(numPts),
				pushX: new Float32Array(numPts),
				pushY: new Float32Array(numPts),
				gHalo: 'hsla(' + hue + ',25%,42%,' + (alpha * 0.35) + ')',
				gHue: hue, gA: alpha
			};
			for (let j = 0; j < numPts; j++) k.pts[j].y = j * h * inv;
			layers[li].push(k);
		}
		// Volumetric light rays
		rays.length = 0;
		for (let i = 0; i < 6; i++) {
			rays.push({
				x: Math.random() * w, ang: (Math.random() - 0.5) * 0.3,
				wd: 70 + Math.random() * 130, a: 0.02 + Math.random() * 0.025,
				spd: 0.25 + Math.random() * 0.45, ph: Math.random() * 6.28
			});
		}
		// Marine snow particles
		snow.length = 0;
		for (let i = 0; i < 60; i++) {
			snow.push({
				x: Math.random() * w, y: Math.random() * h,
				sz: 0.4 + Math.random() * 1.6, sp: 0.15 + Math.random() * 0.35,
				df: (Math.random() - 0.5) * 0.25, al: 0.03 + Math.random() * 0.1
			});
		}
		// Code rain columns for exit animation
		codeCols.length = 0;
		for (let i = 0; i < 45; i++) {
			const depth = 0.2 + Math.random() * 0.8;
			codeCols.push({
				x: (i / 44) * w + (Math.random() - 0.5) * 25,
				y: Math.random() * h,
				spd: 0.75 + depth * 2.5 + Math.random() * 1,
				depth,
				alpha: Math.random(),
				fadeTarget: 1,
				chars: Array.from({ length: 14 }, () => CHARS[Math.floor(Math.random() * CHARS.length)]),
			});
		}
	};
	const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; build(); };
	resize();
	addEventListener('resize', resize);
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
	addEventListener('mouseleave', () => { mx = -9999; my = -9999; });

	let t = 0;
	let visible = true;
	// Track active slide for background mode switching
	let activeSlide = 0;
	let bgMode = 0;          // 0=seaweed, 1=code rain
	let bgTransition = 1;    // 1=fully transitioned
	let targetMode = 0;
	let obs = new IntersectionObserver(es => {
		let maxIntersect = 0, maxSlide = 0;
		es.forEach(e => {
			if (e.isIntersecting && e.intersectionRatio > maxIntersect) {
				maxIntersect = e.intersectionRatio;
				maxSlide = parseInt(e.target.dataset.slide);
				visible = true;
			}
		});
		if (maxSlide !== activeSlide) {
			activeSlide = maxSlide;
			targetMode = maxSlide === 0 ? 0 : 1; // 0=seaweed, 1+=code rain
			bgTransition = 0;
		}
	}, { threshold: [0.1, 0.5, 0.9] });
	document.querySelectorAll('.slide').forEach(s => obs.observe(s));
	const pBuf = new Float64Array(44); // 22 pts × 2
	const fBuf = new Float64Array(44);

	const trace = (pts, len) => {
		ctx.moveTo(pts[0], pts[1]);
		for (let i = 2; i < len - 2; i += 2)
			ctx.quadraticCurveTo(pts[i], pts[i+1], (pts[i]+pts[i+2])*0.5, (pts[i+1]+pts[i+3])*0.5);
		ctx.lineTo(pts[len-2], pts[len-1]);
	};

	const drawLayer = (ki) => {
		const arr = layers[ki];
		if (!arr.length) return;
		const skip = ki === 0;
		for (let ai = 0; ai < arr.length; ai++) {
			const k = arr[ai];
			const n = k.numPts, invN = k.invN;
			const timeSpd = t * k.speed;
			const baseX = k.baseX, amp = k.amp;
			const pts = k.pts;

			// Sway — left straight, right relaxed curves
			const xFrac = k.baseX / w;
			const flex = 0.08 + 0.92 * xFrac * xFrac; // quadratic: 8%→100%
			const a = amp * flex;
			for (let j = 0; j < n; j++) {
				const p = pts[j];
				const frac = j * invN;
				const s1 = Math.sin(timeSpd + p.off + k.phase) * a;
				const s2 = Math.sin(timeSpd * 0.6 + p.off * 1.4 + k.phase * 0.5) * a * 0.35;
				const s3 = Math.sin(timeSpd * 1.7 + p.off * 0.6) * a * 0.12;
				const s4 = Math.sin(timeSpd * 0.35 + p.off * 0.8 + k.phase * 0.3) * a * 0.25 * xFrac;
				pBuf[j*2] = baseX + (s1 + s2 + s3 + s4) * frac * frac;
				pBuf[j*2+1] = p.y;
			}

			// Mouse interaction — traveling pulse from touch point
			const illum = k.illum, pushX = k.pushX, pushY = k.pushY;
			if (skip) {
				illum.fill(0); pushX.fill(0); pushY.fill(0);
			} else if (mx > -1000) {
				// Find nearest point + apply push
				let touchIdx = 0, minD2 = Infinity;
				for (let j = 0; j < n; j++) {
					const dx = mx - pBuf[j*2], dy = my - pBuf[j*2+1];
					const d2 = dx*dx + dy*dy;
					if (d2 < minD2) { minD2 = d2; touchIdx = j; }
					if (d2 < PUSH_R2 && d2 > 1) {
						const d = Math.sqrt(d2);
						const f = (1 - d/PUSH_R)*(1 - d/PUSH_R)*PUSH_K;
						pushX[j] += (dx/d*f - pushX[j]) * 0.06;
						pushY[j] += (dy/d*f*0.3 - pushY[j]) * 0.06;
					} else { pushX[j] *= 0.96; pushY[j] *= 0.96; }
				}
				// Bioluminescent pulse — slow, segment-by-segment propagation
				const touchDist = Math.sqrt(minD2);
				if (touchDist < GLOW_R) {
					const strength = Math.pow(1 - touchDist/GLOW_R, 2.5);
					for (let j = 0; j < n; j++) {
						const d = Math.abs(j - touchIdx);
						// Slow wave: ~0.6 Hz, underwater feel
						const wave = Math.cos(t * 4 - d * 0.5);
						// Sharp segment shape: pow3 makes narrow bright pulses
						const pulse = Math.max(0, Math.pow(Math.max(0, wave), 3));
						const fall = Math.max(0, 1 - d * 0.08);
						illum[j] = strength * pulse * fall;
					}
				} else {
					illum.fill(0);
				}
			} else {
				illum.fill(0); pushX.fill(0); pushY.fill(0);
			}

			// Final positions
			const len = n * 2;
			for (let j = 0; j < len; j += 2) {
				fBuf[j] = pBuf[j] + pushX[j>>1];
				fBuf[j+1] = pBuf[j+1] + pushY[j>>1];
			}

			// Glow halo
			ctx.beginPath(); trace(fBuf, len);
			ctx.strokeStyle = k.gHalo; ctx.lineWidth = k.w + 6; ctx.stroke();

			// Main line
			ctx.beginPath(); trace(fBuf, len);
			const g = ctx.createLinearGradient(baseX - amp, 0, baseX + amp, h);
			g.addColorStop(0, 'hsla('+k.gHue+',28%,40%,'+k.gA*0.1+')');
			g.addColorStop(0.35, 'hsla('+k.gHue+',28%,46%,'+k.gA+')');
			g.addColorStop(0.65, 'hsla('+k.gHue+',28%,46%,'+k.gA+')');
			g.addColorStop(1, 'hsla('+k.gHue+',28%,40%,'+k.gA*0.1+')');
			ctx.strokeStyle = g; ctx.lineWidth = k.w; ctx.stroke();

			// Illumination overlay — pulse glow
			if (!skip && mx > -1000) {
				let maxI = 0;
				for (let j = 0; j < n; j++) if (illum[j] > maxI) maxI = illum[j];
				if (maxI > 0.02) {
					// Glow stroke — opacity & width scale with pulse intensity
					ctx.beginPath(); trace(fBuf, len);
					ctx.strokeStyle = 'hsla(' + (k.gHue + 8) + ',38%,64%,' + (maxI * 0.45) + ')';
					ctx.lineWidth = k.w + 1 + maxI * 5;
					ctx.stroke();
					// Pulse nodes — bright dots along illuminated path
					for (let j = 0; j < n; j++) {
						if (illum[j] > 0.05) {
							const i = illum[j];
							ctx.beginPath();
							ctx.arc(fBuf[j*2], fBuf[j*2+1], 1 + i * 7, 0, 6.28);
							ctx.fillStyle = 'hsla(' + (k.gHue + 5) + ',42%,68%,' + (i * 0.6) + ')';
							ctx.fill();
						}
					}
				}
			}
		}
	};

	const draw = () => {
		if (!visible) { requestAnimationFrame(draw); return; }
		ctx.clearRect(0, 0, w, h);
		t += 0.008;

		// Background mode transition (cross-fade over 1.5s)
		if (bgTransition < 1 && bgMode !== targetMode) {
			bgTransition = Math.min(1, bgTransition + 0.008 / 1.5);
			if (bgTransition >= 1) bgMode = targetMode;
		}
		const crossFade = (bgMode !== targetMode) ? bgTransition : 1;

		// ── Background depth gradient ──
		const bgG = ctx.createLinearGradient(0, 0, 0, h);
		bgG.addColorStop(0, 'rgba(8,12,18,0)');
		bgG.addColorStop(0.5, 'rgba(6,10,16,0.25)');
		bgG.addColorStop(1, 'rgba(4,6,10,0.45)');
		ctx.fillStyle = bgG; ctx.fillRect(0, 0, w, h);

		// ── Seaweed scene (mode 0) ──
		if (bgMode === 0 || (bgMode !== targetMode && targetMode === 1)) {
			const seaAlpha = (targetMode === 1) ? 1 - crossFade : 1;
			ctx.globalAlpha = seaAlpha;

			// ── Volumetric light rays ──
			for (let ri = 0; ri < rays.length; ri++) {
				const r = rays[ri];
				r.x += Math.sin(t * r.spd + r.ph) * 0.35;
				const xoff = Math.sin(r.ang) * h;
				let boost = 0;
				if (mx > -1000) {
					const dist = Math.abs(mx - r.x);
					if (dist < 500) {
						const wave = Math.cos(t * 4 - dist * 0.012);
						boost = Math.pow(Math.max(0, wave), 3) * (1 - dist/500) * 0.035;
					}
				}
				const rg = ctx.createLinearGradient(r.x, 0, r.x + xoff, h);
				const aa = (r.a + boost) * (0.7 + 0.3 * Math.sin(t * r.spd * 0.6 + r.ph));
				rg.addColorStop(0, 'rgba(180,175,155,' + aa + ')');
				rg.addColorStop(0.35, 'rgba(180,175,155,' + (aa * 0.55) + ')');
				rg.addColorStop(0.75, 'rgba(180,175,155,' + (aa * 0.15) + ')');
				rg.addColorStop(1, 'rgba(180,175,155,0)');
				ctx.fillStyle = rg;
				ctx.fillRect(r.x - r.wd, 0, r.wd * 2, h);
			}

			// ── Marine snow ──
			for (let si = 0; si < snow.length; si++) {
				const s = snow[si];
				s.y += s.sp;
				s.x += s.df + Math.sin(t * 0.5 + s.x * 0.01) * 0.08;
				if (s.y > h + 5) { s.y = -5; s.x = Math.random() * w; }
				if (s.x < -5) s.x = w + 5; if (s.x > w + 5) s.x = -5;
				let inRay = false;
				for (let ri = 0; ri < rays.length; ri++) {
					const r = rays[ri];
					const rayX = r.x + Math.sin(r.ang) * s.y;
					if (Math.abs(s.x - rayX) < r.wd * (0.5 + s.y / h * 0.5)) { inRay = true; break; }
				}
				let mglow = 0;
				if (mx > -1000) {
					const dx = mx - s.x, dy = my - s.y;
					const d2 = dx*dx + dy*dy;
					if (d2 < 36000) {
						const dist = Math.sqrt(d2);
						const base = Math.pow(1 - dist/190, 2.5);
						const wave = Math.cos(t * 4 - dist * 0.015);
						const mod = 0.4 + 0.6 * Math.pow(Math.max(0, wave), 3);
						mglow = base * mod;
					}
				}
				const a = s.al * (inRay ? 3.0 : 1.0) + mglow * 0.45;
				ctx.beginPath();
				ctx.arc(s.x, s.y, s.sz * (1 + mglow * 0.8), 0, 6.28);
				ctx.fillStyle = 'rgba(200,195,180,' + Math.min(a, 0.45) + ')';
				ctx.fill();
			}

			// ── Mouse glow (3-zone falloff) ──
			if (mx > -1000) {
				const mg1 = ctx.createRadialGradient(mx, my, 0, mx, my, 100);
				mg1.addColorStop(0, 'rgba(138,140,110,0.09)');
				mg1.addColorStop(0.6, 'rgba(138,140,110,0.04)');
				mg1.addColorStop(1, 'rgba(138,140,110,0)');
				ctx.fillStyle = mg1; ctx.fillRect(0, 0, w, h);
				const mg2 = ctx.createRadialGradient(mx, my, 60, mx, my, 380);
				mg2.addColorStop(0, 'rgba(138,140,110,0.045)');
				mg2.addColorStop(0.4, 'rgba(138,140,110,0.015)');
				mg2.addColorStop(1, 'rgba(138,140,110,0)');
				ctx.fillStyle = mg2; ctx.fillRect(0, 0, w, h);
			}

			drawLayer(0); drawLayer(1); drawLayer(2);
			ctx.globalAlpha = 1;
		}

		// ── Code rain (mode 1) — continuous loop, random mutation ──
		if (bgMode === 1 || (bgMode !== targetMode && targetMode === 1 && crossFade > 0.1)) {
			const rainAlpha = (bgMode === 1) ? 1 : crossFade;
			ctx.globalAlpha = rainAlpha;
			// Random character mutation every ~0.5s
			if (Math.floor(t * 60) % 30 === 0) {
				for (let ci = 0; ci < codeCols.length; ci++) {
					codeCols[ci].chars[Math.floor(Math.random() * 14)] = CHARS[Math.floor(Math.random() * CHARS.length)];
				}
			}
			for (let ci = 0; ci < codeCols.length; ci++) {
				const col = codeCols[ci];
				col.y += col.spd;
				if (col.y > h + 100) { col.y = -100; col.x = (ci / 44) * w + (Math.random()-0.5)*25; }
				// Fade in/out when transitioning
				if (bgMode !== targetMode) {
					col.fadeTarget = targetMode === 1 ? 1 : 0;
				}
				col.alpha += (col.fadeTarget - col.alpha) * 0.02;
				const colAlpha = col.alpha * rainAlpha;
				if (colAlpha < 0.02) continue;
				const fontSize = Math.round(6 + col.depth * 14);
				const doff = Math.abs(col.depth - 0.5);
				const fakeBlur = doff > 0.3 ? (doff - 0.3) * 3 : 0;
				ctx.font = fontSize + 'px monospace';
				if (fakeBlur > 0.5) {
					ctx.globalAlpha = colAlpha * 0.3;
					ctx.fillStyle = 'rgba(138,140,110,0.5)';
					for (let ch = 0; ch < col.chars.length; ch++) {
						const cy = col.y - ch * fontSize * 1.3;
						if (cy > -fontSize && cy < h + fontSize) {
							ctx.fillText(col.chars[ch], col.x + fakeBlur, cy + fakeBlur * 0.5);
							ctx.fillText(col.chars[ch], col.x - fakeBlur, cy - fakeBlur * 0.5);
						}
					}
				}
				ctx.globalAlpha = colAlpha;
				for (let ch = 0; ch < col.chars.length; ch++) {
					const cy = col.y - ch * fontSize * 1.3;
					if (cy > -fontSize && cy < h + fontSize) {
						const headFade = ch === 0 ? 1.0 : (1 - ch / col.chars.length) * 0.5;
						const depthFade = col.depth < 0.35 ? col.depth / 0.35 : col.depth > 0.7 ? (1.0 - col.depth) / 0.3 : 1.0;
						const a = headFade * depthFade * 0.7;
						ctx.fillStyle = 'rgba(138,140,110,' + a + ')';
						ctx.fillText(col.chars[ch], col.x, cy);
					}
				}
			}
			ctx.globalAlpha = 1;
		}

		requestAnimationFrame(draw);
	};
	draw();
})(); } catch(e) { console.warn('[seaweed]', e.message); }




// ═══ Wave particles (Contact) — 60fps optimized ═══
try { (() => {
	const c = document.getElementById('waves');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const particles = [];
	const N = 180;
	let cx, cy;

	const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; cx = w/2; cy = h/2; };
	resize();
	addEventListener('resize', resize);

	for (let i = 0; i < N; i++) {
		const angle = (i / N) * Math.PI * 2;
		const r = 60 + Math.random() * 220;
		particles.push({
			bA: angle, bR: r,
			x: cx + Math.cos(angle) * r,
			y: cy + Math.sin(angle) * r,
			speed: 0.002 + Math.random() * 0.004,
			r: 0.8 + Math.random() * 2.2,
			alpha: 0.08 + Math.random() * 0.35,
			twinkle: Math.random() * Math.PI * 2
		});
	}

	let time = 0;
	let visible = true;
	const obs = new IntersectionObserver(es => { es.forEach(e => { visible = e.isIntersecting; }); }, { threshold: 0.1 });
	obs.observe(c);
	const draw = () => {
		if (!visible) { requestAnimationFrame(draw); return; }
		ctx.clearRect(0, 0, w, h);
		time += 0.016;

		// Center glow
		const pulse = 1 + Math.sin(time) * 0.08;
		const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 320 * pulse);
		grad.addColorStop(0, 'rgba(138,140,110,0.07)');
		grad.addColorStop(1, 'rgba(138,140,110,0)');
		ctx.fillStyle = grad;
		ctx.fillRect(0, 0, w, h);

		// Wave rings
		for (let ring = 0; ring < 6; ring++) {
			const ringR = ((time * 45 + ring * 70) % 360) * pulse;
			ctx.beginPath();
			ctx.arc(cx, cy, ringR, 0, 6.28);
			ctx.strokeStyle = 'rgba(138,140,110,' + ((1 - ringR / 360) * 0.09) + ')';
			ctx.lineWidth = 1.2;
			ctx.stroke();
		}

		// Update particle positions + draw particles
		for (let i = 0; i < N; i++) {
			const p = particles[i];
			const angle = p.bA + time * p.speed;
			const r = p.bR + Math.sin(time * 2 + p.bA) * 18;
			p.x = cx + Math.cos(angle) * r;
			p.y = cy + Math.sin(angle) * r;
			const tw = 0.5 + Math.sin(time * 3 + p.twinkle) * 0.5;
			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r, 0, 6.28);
			ctx.fillStyle = 'rgba(138,140,110,' + (p.alpha * (0.4 + tw * 0.6)) + ')';
			ctx.fill();
		}

		// Batch ALL connection lines into ONE path, ONE stroke
		// This reduces GPU draw calls from ~60,000 to 1
		const CONN_DIST2 = 70 * 70; // squared threshold
		ctx.beginPath();
		let hasConn = false;
		for (let i = 0; i < N; i++) {
			const pi = particles[i];
			for (let j = i + 1; j < N; j++) {
				const pj = particles[j];
				const dx = pi.x - pj.x, dy = pi.y - pj.y;
				const d2 = dx * dx + dy * dy;
				if (d2 < CONN_DIST2) {
					ctx.moveTo(pi.x, pi.y);
					ctx.lineTo(pj.x, pj.y);
					hasConn = true;
				}
			}
		}
		if (hasConn) {
			ctx.strokeStyle = 'rgba(138,140,110,0.06)';
			ctx.lineWidth = 0.5;
			ctx.stroke();
		}

		requestAnimationFrame(draw);
	};
	draw();
})(); } catch(e) { console.warn('[wave]', e.message); }




// ═══ Slide observer ═══
try { (() => {
	const sl = document.getElementById('slideshow');
	const ss = document.querySelectorAll('.slide');
	const ib = document.getElementById('indicator-bar');
	const header = document.getElementById('header');
	if (!sl || !ss.length) return;
	const r = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	ss[0]?.classList.add('is-active');
	if (r) { ss.forEach(s => s.classList.add('is-active')); return; }
	const o = new IntersectionObserver(es => {
		es.forEach(e => {
			if (e.isIntersecting && e.intersectionRatio > 0.5) {
				ss.forEach(s => { if (s !== e.target) s.classList.remove('is-active'); });
				e.target.classList.add('is-active');
				const i = Array.from(ss).indexOf(e.target);
				if (ib) ib.style.transform = 'scaleY(' + ((i + 1) / ss.length) + ')';
				// Header scroll state
				if (header) header.classList.toggle('scrolled', i > 0);
			}
		});
	}, { threshold: 0.5 });
	ss.forEach(s => o.observe(s));
})(); } catch(e) { console.warn("[2]", e.message); }

// ═══ Number counter animation ═══
try { (() => {
	const els = document.querySelectorAll('.stat-value[data-target]');
	if (!els.length) return;
	const reduce = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	const fmt = n => n.toLocaleString();
	if (reduce) { els.forEach(el => el.textContent = fmt(parseInt(el.dataset.target || '0', 10) || el.textContent)); return; }

	const seen = new Set();
	const obs = new IntersectionObserver(entries => {
		entries.forEach(entry => {
			if (entry.isIntersecting && !seen.has(entry.target)) {
				seen.add(entry.target);
				const el = entry.target;
				const target = parseInt(el.dataset.target || '0', 10) || 0;
				// Use data-suffix if present, else detect '+' in original text
				const suffix = el.dataset.suffix || (el.textContent.includes('+') ? '+' : '');
				const dur = 1800;
				const start = performance.now();
				const tick = now => {
					const p = Math.min((now - start) / dur, 1);
					const eased = 1 - Math.pow(1 - p, 4); // easeOutQuart
					el.textContent = fmt(Math.floor(target * eased)) + suffix;
					if (p < 1) requestAnimationFrame(tick);
					else el.textContent = fmt(target) + suffix;
				};
				requestAnimationFrame(tick);
			}
		});
	}, { threshold: 0.4 });
	els.forEach(el => obs.observe(el));
})(); } catch(e) { console.warn("[3]", e.message); }

// ═══ Gallery 3D tilt ═══
try { (() => {
	const cards = document.querySelectorAll('.gcard');
	if (!cards.length || matchMedia?.('(prefers-reduced-motion: reduce)').matches || matchMedia?.('(pointer: coarse)').matches) return;
	cards.forEach(card => {
		card.addEventListener('mousemove', e => {
			const r = card.getBoundingClientRect();
			const px = (e.clientX - r.left) / r.width - 0.5; // -0.5 .. 0.5
			const py = (e.clientY - r.top) / r.height - 0.5;
			card.style.setProperty('--ry', (px * 14).toFixed(2) + 'deg');
			card.style.setProperty('--rx', (-py * 12).toFixed(2) + 'deg');
			card.classList.add('tilting');
		});
		card.addEventListener('mouseleave', () => {
			card.classList.remove('tilting');
		});
	});
})(); } catch(e) { console.warn("[4]", e.message); }

// ═══ Smooth anchor ═══
try { (() => {
	document.querySelectorAll('a[href^="#"]').forEach(a => {
		a.addEventListener('click', e => {
			e.preventDefault();
			const href = a.getAttribute('href');
			const t = document.querySelector(href);
			if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
})(); } catch(e) { console.warn('[anchor]', e.message); }

</script>
