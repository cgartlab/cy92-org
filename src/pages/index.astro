---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LangScript from '../components/LangScript.astro';
import { SITE_TITLE, SITE_DESCRIPTION_EN, PERSONAL_INFO, SKILLS, SKILLS_EN, SOCIAL_LINKS, HONORS, HONORS_EN, WORK_EXPERIENCE, WORK_EXPERIENCE_EN, EDUCATION, EDUCATION_EN, STATS } from '../consts';

// 累计字数：由 src/scripts/sync-word-count.mjs 从 cgartlab.github.io 统计后
// 原子写回 consts.ts 的 STATS[0].value。此处去逗号后作为 data-target 与首帧文本，
// 否则同步脚本改的数字永远不会出现在页面上（STATS 原本无人消费）。
const wordsPublished = STATS[0].value.replace(/,/g, '');

const coverImage = '/images/冥想系列-cover.webp';
const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 2014;
const meditationImages = [
	{ src: '/images/冥想系列-1754664750528.webp', title: '冥想系列 1', titleEn: 'Meditation 1', desc: '早期冥想探索，意识的初次解剖', descEn: 'Early meditation exploration — the first dissection of consciousness' },
	{ src: '/images/冥想系列-1754664757458.webp', title: '冥想系列 2', titleEn: 'Meditation 2', desc: '内心对话，矛盾与冲突的视觉化', descEn: 'An inner dialogue; contradictions and conflict made visible' },
	{ src: '/images/冥想系列-1754664764581.webp', title: '冥想系列 3', titleEn: 'Meditation 3', desc: '繁重压迫下的精神释放', descEn: 'Spiritual release under heavy pressure' },
	{ src: '/images/冥想系列-1754664772045.webp', title: '冥想系列 4', titleEn: 'Meditation 4', desc: '对立统一，真实的自我映射', descEn: 'Unity of opposites; a true reflection of the self' },
	{ src: '/images/冥想系列-1754664780351.webp', title: '冥想系列 5', titleEn: 'Meditation 5', desc: '意识深处的宁静与动荡', descEn: 'Stillness and turbulence deep inside consciousness' },
	{ src: '/images/冥想系列-1754664786331.webp', title: '冥想系列 6', titleEn: 'Meditation 6', desc: '精神世界的数字重构', descEn: 'A digital reconstruction of the inner world' },
	{ src: '/images/冥想系列-1754664798635.webp', title: '冥想系列 7', titleEn: 'Meditation 7', desc: '内在探索的第七阶段', descEn: 'The seventh stage of inward exploration' },
	{ src: '/images/冥想系列-1754664814920.webp', title: '冥想系列 8', titleEn: 'Meditation 8', desc: '接近实相的道路', descEn: 'The road toward reality' },
	{ src: '/images/冥想系列-1754664822895.webp', title: '冥想系列 9', titleEn: 'Meditation 9', desc: '意识的最终形态', descEn: 'The final form of consciousness' },
	{ src: '/images/冥想系列-1754664829706.webp', title: '冥想系列 10', titleEn: 'Meditation 10', desc: '冥想之旅的终点与起点', descEn: 'Where the journey of meditation ends — and begins' }
];

// English counterpart of the meditation gallery copy (same order).
const meditationImagesEn = meditationImages.map(m => ({
	src: m.src,
	title: m.titleEn,
	desc: m.descEn
}));

// 跑马灯素材：仅限 cgartlab.com 文章标题 + 文章金句
const tickerItems = [
	'Men（门）Agent 团队',
	'你不知道的 AI 优雅食用指南（一）：慢一点比较快',
	'我的上帝模式：一名设计师创作环境的演变',
	'Inkard 卡片生成器',
	'自动给文章术语加百科链接',
	'Argus 前端设计代码审查 Agent',
	'Go To GitHub 访问加速工具',
	'EDIC 设计系统：面向人类与 Agent 的编辑主义设计系统',
	'世界尽管让它去转，不用担心你学的东西会过时',
	'就算掌声无法抵达舞台，我依然劝你尽快动笔',
	'RSS 与现代阅读习惯：重新获取信息收集的主动权',
	'大型三维设计项目实战心得：小小的文件命名',
	'十五年的浏览器折腾之旅',
	'碎片写作——建立一具思维标本',
	'用小学数学破除情绪的二元对立',
	'冥想系列：解剖自己内心的过程',
	'面对 AI，我们和长辈其实没什么两样——都习惯了执行规则，却从未学习设计规则',
	'从「规则执行者」到「规则设计师」，慢一点，才能真正用好 AI',
	'互联网是一片大海，网站是浪花，而浏览器是你脚下的那块冲浪板',
	'电脑要换的，软件要更新的，只有数据不出意外是要伴随你一辈子的',
	'一个人独处时，如果你没有想起任何其他人，是快乐的',
	'写作是建立思维标本的过程：系统化地整理与表达思考',
	'什么更重要、什么最重要、是否具有长期价值——我的三板斧',
	'网页里那个「下载」图标越大，就越不是你要找的下载链接',
];
// English counterpart of the ticker copy (same order — the marquee is decorative
// texture and aria-hidden, so both languages ride the same track).
const tickerItemsEn = [
	'Men — a 6+1 agent team',
	'How to Use AI Elegantly, Part 1: Slower Is Faster',
	'My God Mode: A Designer\u2019s Evolving Creative Setup',
	'Inkard Card Generator',
	'Auto-linking article terms to encyclopedic entries',
	'Argus — a front-end design code-review agent',
	'Go To GitHub — a GitHub access accelerator',
	'EDIC — an editorial design system for humans and agents',
	'Let the world keep turning; do not worry that what you learn will go out of date',
	'Even if no applause ever reaches the stage, I still urge you to start writing',
	'RSS and Modern Reading Habits: Taking Back Control of Your Information',
	'Field Notes from Large 3D Projects: It is the File Names',
	'Fifteen Years of Messing with Browsers',
	'Fragment Writing: Building a Specimen of Thought',
	'Breaking the Binary of Emotion with Elementary Math',
	'Meditation Series: The Process of Dissecting Your Own Inner Self',
	'Facing AI, we are not so different from our elders — all used to executing rules, never learning to design them',
	'From Rule Executor to Rule Designer: slow down, and you will actually use AI well',
	'The internet is a sea, websites are the waves, and the browser is the surfboard under your feet',
	'Computers get replaced and software gets updated; only your data stays with you for life',
	'When alone, you are happy if you do not find yourself thinking of anyone else',
	'Writing is how you make specimens of thought: organizing and expressing it systematically',
	'What Matters More, What Matters Most, What Has Long-Term Value — My Three Axes',
	'The bigger the Download icon on a page, the less likely it is the link you want',
];
// ticker 几何与纵深：高低错落、长度不一（w=带宽, lx=左偏移, ad=方向）
const tickerRows = [
	{ top: 5,  dur: 40, sc: 0.6,  bl: 2.6, op: 0.3,  w: 82, lx: 0,  ad: 'normal' },
	{ top: 13, dur: 30, sc: 0.84, bl: 1.2, op: 0.5,  w: 95, lx: 5,  ad: 'normal' },
	{ top: 19, dur: 24, sc: 1.02, bl: 0.2, op: 0.82, w: 72, lx: 0,  ad: 'normal' },
	{ top: 26, dur: 46, sc: 0.7,  bl: 1.9, op: 0.4,  w: 88, lx: 12, ad: 'normal' },
	{ top: 68, dur: 48, sc: 0.64, bl: 2.3, op: 0.34, w: 85, lx: 14, ad: 'reverse' },
	{ top: 75, dur: 27, sc: 1.06, bl: 0,   op: 0.86, w: 62, lx: 0,  ad: 'reverse' },
	{ top: 82, dur: 35, sc: 0.86, bl: 1.0, op: 0.55, w: 93, lx: 6,  ad: 'reverse' },
	{ top: 90, dur: 42, sc: 0.6,  bl: 2.7, op: 0.28, w: 76, lx: 2,  ad: 'reverse' },
];
---

<!doctype html>
<html lang="zh-CN" style="color-scheme:dark">
	<head>
		<BaseHead title={SITE_TITLE} description={PERSONAL_INFO.description} descriptionEn={SITE_DESCRIPTION_EN} />
	</head>
	<body>
	<LangScript />

	<a href="#slideshow" class="skip-link" data-t="skipLink">Skip to content</a>

		<!-- ═══ Immersive Header ═══ -->
		<header class="header" id="header">
			<a href="/" class="header-logo">CHEN YANG</a>
			<nav class="header-nav">
				<div class="nav-hover">
					<a href="#work" class="header-link work-link" aria-haspopup="true" aria-expanded="false">Work<span class="caret"></span></a>
					<div class="nav-menu" role="menu" data-t-aria="workNavAria" aria-label="Work navigation">
						<a class="nav-menu-link" href="#work" role="menuitem" data-t="navCollection">All Works</a>
						<a class="nav-menu-link" href="#meditation" role="menuitem" data-t="navMeditation">Meditation Series</a>
						<span class="nav-menu-divider"></span>
						<span class="nav-menu-note" data-t="navMore">More works coming soon</span>
						{/* 未来新作品在此追加，例如: <a href="https://men.cgartlab.com">Men</a> / <a href="https://argus.cgartlab.com">Argus</a> */}
					</div>
				</div>
				<a href="https://cgartlab.com" class="header-link" target="_blank" rel="noopener noreferrer">Blog<span class="caret ext"></span></a>
				<a href="#profile" class="header-link">Profile</a>
				<a href="#contact" class="header-link">Contact</a>
			</nav>
			<div class="header-right">
				<button class="lang-btn" data-lang-toggle id="langToggle" type="button" data-t-aria="langAria" aria-label="Switch language">中/En</button>
				<span class="header-sep" aria-hidden="true"></span>
				<a href={`mailto:${PERSONAL_INFO.email}`} class="header-email">{PERSONAL_INFO.email}</a>
			</div>
		</header>

		<!-- ═══ Slideshow ═══ -->
		<main id="slideshow" class="slideshow">
			<canvas id="seaweed" class="canvas-full" style="position:fixed;z-index:50;pointer-events:none" aria-hidden="true"></canvas>
			<!-- Shared continuous video — one undimmed scene behind pages 3 & 4 -->
			<video id="reel" class="reel" autoplay muted loop playsinline preload="none" aria-hidden="true">
				<source src="/video/Demo-lite.mp4" type="video/mp4" />
			</video>
			<!-- Fixed edge mask — permanently hides the video's hard top/bottom edges,
			     stays put while pages 3 & 4 switch (does not scroll with slides) -->
			<div id="edge-mask" aria-hidden="true"></div>
			<!-- Fixed scene layers — full-viewport backgrounds that crossfade on page
			     changes, so no hard edge ever appears between backgrounds -->
			<canvas id="grad" class="scene-layer" aria-hidden="true"></canvas>
			<canvas id="aurora" class="scene-layer" aria-hidden="true"></canvas>
			<!-- Shared silver-gray gradient scene for About & Contact (seamless) -->
			<div id="silver" class="scene-layer silver-scene" aria-hidden="true"></div>

			<!-- ═══ Slide 0 — Hero (Seaweed particles) ═══ -->
			<section class="slide dark" data-slide="0">
				<div class="slide-content center">
					<div class="hero">
						<h1 class="hero-name anim scale" data-d="0" aria-label="CHEN YANG">
							<span class="hl" aria-hidden="true"><span>C</span><span>H</span><span>E</span><span>N</span></span>
							<span class="hl" aria-hidden="true"><span>Y</span><span>A</span><span>N</span><span>G</span></span>
						</h1>
						<div class="hero-subline anim up" data-d="1">
							<p class="hero-role">A <span class="rwd" style="--ri:0"><span class="inner">Designer</span></span>, <span class="rwd" style="--ri:1"><span class="inner">Writer</span></span>, <span class="rwd" style="--ri:2"><span class="inner">Engineer</span></span>.</p>
						</div>
						<div class="hero-divider"></div>
						<p class="hero-tags anim blur" data-d="2"><span data-t="heroTag1">Motion Visual Designer</span><span class="sep"> · </span><span data-t="heroTag2">Content Creator</span><span class="sep"> · </span><span data-t="heroTag3">Product Engineer</span></p>
						<a href="#stats" class="scroll-cue anim up" data-d="3" data-t-aria="scrollCueAria" aria-label="Scroll down to the statistics slide">
							<span class="cue-label">Scroll</span>
							<span class="cue-track"><span class="cue-dot"></span></span>
						</a>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 1 — Stats (transparent: reveals fixed scene layers) ═══ -->
			<section class="slide dark" data-slide="1" id="stats">
				{/* Horizontal left→right content ticker — real cgartlab titles/excerpts, works */}
				<div class="ticker" aria-hidden="true">
					{tickerRows.map((row, i) => (
						<div
							class="ticker-row"
							style={`top:${row.top}dvh;left:${row.lx}%;width:${row.w}%;--dur:${row.dur}s;--sc:${row.sc};--bl:${row.bl}px;--op:${row.op};--ad:${row.ad}`}
						>
							<div class="ticker-track">
								{/* 24 items = 4-unit cycle × 6 → both halves identical → seamless -50%→0 loop */}
								{Array.from({ length: 24 }, (_, n) => {
									const idx = (i * 2 + (n % 4)) % tickerItems.length;
									return <span class="ticker-item"><span class="tw"><span data-l="zh">{tickerItems[idx]}</span><span data-l="en">{tickerItemsEn[idx]}</span></span><span class="ticker-sep">·</span></span>;
								})}
							</div>
						</div>
					))}
				</div>
				<div class="slide-content center">
					<div class="stats">
						<div class="stat anim up" data-d="0">
							<span class="stat-kicker" data-t="statKicker1">Words Published</span>
							<div class="stat-line">
								<span class="stat-value" data-target={wordsPublished}>{wordsPublished}</span>
								<span class="stat-unit" data-t="statUnit1">words</span>
							</div>
						</div>
						<div class="stat anim up" data-d="1">
							<span class="stat-kicker" data-t="statKicker2">Code Commits (Past Year)</span>
							<div class="stat-line">
								<span class="stat-value" data-target="5565">5565</span>
								<span class="stat-unit" data-t="statUnit2">commits</span>
							</div>
						</div>
						<div class="stat anim up" data-d="2">
							<span class="stat-kicker" data-t="statKicker3">Years in Digital Creation</span>
							<div class="stat-line">
								<span class="stat-value" data-target={yearsActive}>{yearsActive}</span>
								<span class="stat-unit" data-t="statUnit3">years</span>
							</div>
						</div>
						<div class="stat anim up" data-d="3">
							<span class="stat-kicker"><span data-t="statKicker4">Article Views</span>
								{/* 数据读取点（少数派个人主页成就卡片）：#viewCount > span（当前约 89.5万+，随时间增长） */}
								<a class="stat-src" href="https://sspai.com/u/cgartlab" target="_blank" rel="noopener noreferrer" data-t-aria="dataSrcAria" aria-label="Source: my sspai.com profile"><span data-t="statSrc">sspai.com</span> ↗</a>
							</span>
							<div class="stat-line">
								<!-- 同一数据点双单位：中文用「万+」，英文换算为 K+（89.5万 ≈ 895K） -->
								<span class="stat-value" data-l="zh" data-target="89.5" data-dec="1" data-suffix="万+">89.5万+</span>
								<span class="stat-value" data-l="en" data-target="895" data-suffix="K+">895K+</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 2 — What I do (page 3: center → corner, video 0.5 → full) ═══ -->
			<section class="slide" data-slide="2">
				<div class="video-dim"></div>
				<div class="slide-content">
					<div class="glass" aria-hidden="true"></div>
					<div class="split">
						<div class="split-left">
							<p class="label anim up" data-d="0">What I do</p>
							<h2 class="heading-xl anim up" data-d="1"><span data-t="whatHeading">Cross-Domain<br/>Digital Creator</span></h2>
							<p class="body anim up" data-d="2">
								<span data-t="whatBody">I create digital products, shape brand visuals, and share the thinking behind the work. An advocate of data sovereignty — creation as cognition.</span>
							</p>
						</div>
						<div class="split-right anim right" data-d="3">
							<div class="skills">
								<div class="bl" data-l="zh">
									{SKILLS.map((category, i) => (
										<div class="skill">
											<h3 class="skill-cat">{category.category}</h3>
											<ul class="skill-list">
												{category.items.map(s => <li>{s}</li>)}
											</ul>
										</div>
									))}
								</div>
								<div class="bl" data-l="en">
									{SKILLS_EN.map((category, i) => (
										<div class="skill">
											<h3 class="skill-cat">{category.category}</h3>
											<ul class="skill-list">
												{category.items.map(s => <li>{s}</li>)}
											</ul>
										</div>
									))}
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 3 — Featured Work (over shared reel video, text corner) ═══ -->
			<section class="slide" data-slide="3" id="work">
				<div class="slide-content">
					<div class="glass" aria-hidden="true"></div>
					<div class="work">
						<p class="label anim left" data-d="0">Featured Work</p>
						<h2 class="heading-xl anim left" data-d="1"><span data-t="workTitle">A decade in motion visuals — nothing but love for the craft.</span></h2>
						<p class="body-lg anim up" data-d="2">
							<span data-t="workBody1">From 3D animation and CG art to motion design and digital products — a decade of exploring media and narrative. No shortcuts, just love and persistence: every piece pushes a boundary.</span>
						</p>
						<p class="body anim up" data-d="3">
							<span data-t="workBody2">From the experimental VR piece Hello World 2.0, to brand event openers, to CCG EXPO’s COVID-19 — the work and medium evolve, but the reason I first picked up the pen never changed.</span>
						</p>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 4 — Meditation (cover Ken Burns infinite, light text) ═══ -->
			<!-- ═══ Slide 5 (page 5) — Meditation: full-bleed artwork deck ═══ -->
			<section class="slide" data-slide="4" id="meditation">
				<div class="meddeck">
					{meditationImages.map((img, i) => (
						<article class="mdeck-item" data-mid={i} tabindex="0" data-aria-zh={`${img.title} — ${img.desc}`} data-aria-en={`${img.titleEn} — ${img.descEn}`} aria-label={`${img.titleEn} — ${img.descEn}`}
							style={`--pan-x:${['2%','-1.5%','1.5%','-2%','1%','-0.8%','1.8%','-1%','0.8%','-1.8%'][i] || '1%'};--pan-y:${['-1%','1.5%','-0.5%','0.8%','-1.2%','0.6%','-1%','1.2%','-0.6%','0.8%'][i] || '-0.5%'};--pan-ox:${['30%','70%','45%','60%','35%','65%','40%','55%','50%','65%'][i] || '50%'};--pan-oy:${['35%','60%','50%','40%','55%','45%','60%','35%','50%','45%'][i] || '50%'}`}>
							<img class="mdeck-img" src={img.src} alt={img.titleEn} data-aria-zh={`${img.title} — ${img.desc}`} data-aria-en={`${img.titleEn} — ${img.descEn}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							<span class="mdeck-index">{(i + 1).toString().padStart(2, '0')}<em> / {meditationImages.length}</em></span>
							<div class="mdeck-hover">
								<div class="mdeck-card">
									<h3 class="mdeck-title"><span data-l="zh">{img.title}</span><span data-l="en">{img.titleEn}</span></h3>
									<p class="mdeck-desc"><span data-l="zh">{img.desc}</span><span data-l="en">{img.descEn}</span></p>
								</div>
							</div>
						</article>
					))}
					{/* Final stop — all works arranged as a geometric full-bleed wall */}
					<article class="mdeck-item medwall" data-mid="-1" tabindex="0" data-t-aria="medAllAria" aria-label="Meditation Series — all works">
						<div class="medwall-grid">
							{meditationImages.map((img, i) => (
								<div class="medwall-cell" style={`--i:${i}`} aria-hidden="true"><img src={img.src} alt="" loading="lazy" decoding="async" /></div>
							))}
						</div>
						<div class="medwall-cap">
							<span class="medwall-eyebrow">Meditation Series</span>
							<span class="medwall-count"><span data-t="allWorks">All works</span> · 01 – {String(meditationImages.length).padStart(2, '0')}</span>
						</div>
					</article>
				</div>
			</section>

			<!-- ═══ Slide 6 → now 5 — Profile (About) ═══ -->
			<section class="slide dark" data-slide="5" id="profile">
				<div class="slide-content scroll-y">
					<div class="profile">
						<div class="profile-left">
							<p class="label anim left" data-d="0">About</p>
							<h2 class="heading-lg anim left" data-d="1"><span data-t="aboutHeading">Painting rewards itself with painting; writing rewards itself with writing.</span></h2>
							<p class="body anim up" data-d="2"><span data-t="aboutBody1">A motion-visual designer by training, I have spent over a decade moving between design, animation, and front-end. Now I treat writing as the gateway to thinking, AI as a collaborator, and every project as a methodology experiment: slower is faster — design the rules first, then execute.</span></p>
							<p class="body anim up" data-d="3"><span data-t="aboutBody2">I believe in data sovereignty and creation as cognition — never handing yourself over to a closed platform, never letting ideas die in a draft. Tools update, software gets retired; what stays is the ability to think clearly. CG Art Lab is where I write it down, build it out, and prove it works.</span></p>
							<div class="profile-contact anim up" data-d="4">
								<p class="label-sm">Contact</p>
								<div class="contact-row">
									{SOCIAL_LINKS.slice(0, 4).map(link => (
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link" title={link.nameEn} data-t-title={link.i18n} aria-label={link.nameEn}>
											<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
										</a>
									))}
								</div>
							</div>
						</div>
						<div class="profile-right">
							<section class="psection anim right" data-d="1">
