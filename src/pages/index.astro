<script>
// ═══ Seaweed — large kelp, depth layers, mouse illumination spread ═══
try { (() => {
	const c = document.getElementById('seaweed');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const layers = [[], [], []]; // 0=far, 1=mid, 2=near
	let mx = -9999, my = -9999;
	const GLOW_R = 240, PUSH_R = 300, PUSH_K = 40, SPREAD = 0.86;

	const build = () => {
		layers[0].length = 0; layers[1].length = 0; layers[2].length = 0;
		const n = Math.max(40, Math.floor(w / 26));
		for (let i = 0; i < n; i++) {
			const t = i / n;
			const li = t < 0.33 ? 0 : t < 0.66 ? 1 : 2;
			const numPts = li === 0 ? 8 + Math.floor(Math.random() * 3) : 10 + Math.floor(Math.random() * 5);
			layers[li].push({
				baseX: t * w + (Math.random() - 0.5) * 50,
				hue: 65 + Math.random() * 35,
				alpha: [0.025, 0.065, 0.13][li] + Math.random() * 0.03,
				w: [0.4, 1.0, 2.0][li] + Math.random() * 0.7,
				blur: [3, 0.6, 0][li],
				speed: 0.2 + Math.random() * 0.3,
				phase: Math.random() * 6.28,
				amp: 25 + Math.random() * 40,
				pts: Array.from({ length: numPts }, (_, j) => ({
					y: (j / (numPts - 1)) * h,
					off: Math.random() * 6.28
				})),
				ilum: new Float32Array(numPts),
				pushX: new Float32Array(numPts),
				pushY: new Float32Array(numPts)
			});
		}
	};
	const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; build(); };
	resize();
	addEventListener('resize', resize);
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
	addEventListener('mouseleave', () => { mx = -9999; my = -9999; });

	let t = 0;
	const trace = (c2, pts) => {
		if (pts.length < 2) return;
		c2.moveTo(pts[0].x, pts[0].y);
		for (let i = 1; i < pts.length - 1; i++) {
			const xc = (pts[i].x + pts[i + 1].x) / 2;
			const yc = (pts[i].y + pts[i + 1].y) / 2;
			c2.quadraticCurveTo(pts[i].x, pts[i].y, xc, yc);
		}
		c2.lineTo(pts[pts.length - 1].x, pts[pts.length - 1].y);
	};

	const drawLayer = (ki) => {
		const arr = layers[ki];
		if (!arr.length) return;
		if (arr[0].blur > 0) ctx.filter = 'blur(' + arr[0].blur + 'px)';

		arr.forEach(k => {
			// ── Compute sway positions ──
			const pos = k.pts.map((p, j) => {
				const frac = j / (k.pts.length - 1);
				const s1 = Math.sin(t * k.speed + p.off + k.phase) * k.amp;
				const s2 = Math.sin(t * k.speed * 0.6 + p.off * 1.4 + k.phase * 0.5) * k.amp * 0.35;
				const s3 = Math.sin(t * k.speed * 1.7 + p.off * 0.6) * k.amp * 0.12;
				// Bottom anchored: top sways more
				const sway = (s1 + s2 + s3) * Math.pow(frac, 0.65);
				return { x: k.baseX + sway, y: p.y };
			});

			// ── Mouse illumination spread along path (skip for far layer) ──
			if (ki === 0) { k.illum.fill(0); } else if (mx > -1000) {
				pos.forEach((p, i) => {
					const dx = mx - p.x, dy = my - p.y;
					const d = Math.sqrt(dx * dx + dy * dy);
					k.illum[i] = d < GLOW_R ? Math.pow(1 - d / GLOW_R, 1.5) : 0;
				});
				for (let i = 1; i < k.illum.length; i++)
					k.illum[i] = Math.max(k.illum[i], k.illum[i - 1] * SPREAD);
				for (let i = k.illum.length - 2; i >= 0; i--)
					k.illum[i] = Math.max(k.illum[i], k.illum[i + 1] * SPREAD);
			} else {
				k.illum.fill(0);
			}

			// ── Mouse repel (skip for far layer) ──
			if (ki === 0) { k.pushX.fill(0); k.pushY.fill(0); } else if (mx > -1000) {
				pos.forEach((p, i) => {
					const dx = p.x - mx, dy = p.y - my;
					const d = Math.sqrt(dx * dx + dy * dy);
					if (d < PUSH_R && d > 1) {
						const f = Math.pow(1 - d / PUSH_R, 2) * PUSH_K;
						k.pushX[i] += (dx / d * f - k.pushX[i]) * 0.06;
						k.pushY[i] += (dy / d * f * 0.3 - k.pushY[i]) * 0.06;
					} else {
						k.pushX[i] *= 0.93;
						k.pushY[i] *= 0.93;
					}
				});
			} else {
				k.pushX.fill(0); k.pushY.fill(0);
			}

			// Final points
			const fp = pos.map((p, i) => ({
				x: p.x + k.pushX[i],
				y: p.y + k.pushY[i]
			}));

			// ── Draw glow halo (wide, soft) ──
			ctx.beginPath();
			trace(ctx, fp);
			ctx.strokeStyle = 'hsla(' + k.hue + ',25%,42%,' + (k.alpha * 0.35) + ')';
			ctx.lineWidth = k.w + 6;
			ctx.stroke();

			// ── Draw main line ──
			ctx.beginPath();
			trace(ctx, fp);
			const g = ctx.createLinearGradient(k.baseX - k.amp, 0, k.baseX + k.amp, h);
			g.addColorStop(0, 'hsla(' + k.hue + ',28%,40%,' + (k.alpha * 0.1) + ')');
			g.addColorStop(0.35, 'hsla(' + k.hue + ',28%,46%,' + k.alpha + ')');
			g.addColorStop(0.65, 'hsla(' + k.hue + ',28%,46%,' + k.alpha + ')');
			g.addColorStop(1, 'hsla(' + k.hue + ',28%,40%,' + (k.alpha * 0.1) + ')');
			ctx.strokeStyle = g;
			ctx.lineWidth = k.w;
			ctx.stroke();

			// ── Illumination overlay ──
			let maxI = 0;
			for (let i = 0; i < k.illum.length; i++) if (k.illum[i] > maxI) maxI = k.illum[i];
			if (maxI > 0.02) {
				ctx.beginPath();
				trace(ctx, fp);
				ctx.strokeStyle = 'hsla(' + (k.hue + 8) + ',38%,64%,' + (maxI * 0.4) + ')';
				ctx.lineWidth = k.w + 1.5;
				ctx.stroke();
				// Bright nodes where illumination is strong
				fp.forEach((p, i) => {
					if (k.illum[i] > 0.2) {
						ctx.beginPath();
						ctx.arc(p.x, p.y, 1.5 + k.illum[i] * 3, 0, 6.28);
						ctx.fillStyle = 'hsla(' + (k.hue + 5) + ',42%,68%,' + (k.illum[i] * 0.55) + ')';
						ctx.fill();
					}
				});
			}
		});
		ctx.filter = 'none';
	};

	const draw = () => {
		ctx.clearRect(0, 0, w, h);
		t += 0.008;

		// Soft ambient mouse glow
		if (mx > -1000) {
			const mg = ctx.createRadialGradient(mx, my, 0, mx, my, 380);
			mg.addColorStop(0, 'rgba(138,140,110,0.035)');
			mg.addColorStop(1, 'rgba(138,140,110,0)');
			ctx.fillStyle = mg;
			ctx.fillRect(0, 0, w, h);
		}

		drawLayer(0);
		drawLayer(1);
		drawLayer(2);

		requestAnimationFrame(draw);
	};
	draw();
})();
} catch(e) { console.warn('[seaweed]', e.message); }

// ═══ Wave particles (Contact) ═══
(() => {
	const c = document.getElementById('waves');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const particles = [];
	const N = 180;
	let cx, cy;
	let mx = -999, my = -999;

	const resize = () => {
		w = c.width = innerWidth;
		h = c.height = innerHeight;
		cx = w / 2; cy = h / 2;
	};
	resize();
	addEventListener('resize', resize);
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });

	for (let i = 0; i < N; i++) {
		const angle = (i / N) * Math.PI * 2;
		const r = 60 + Math.random() * 220;
		particles.push({
			baseAngle: angle,
			baseR: r,
			x: cx + Math.cos(angle) * r,
			y: cy + Math.sin(angle) * r,
			speed: 0.002 + Math.random() * 0.004,
			r: 0.8 + Math.random() * 2.2,
			alpha: 0.08 + Math.random() * 0.35,
			twinkle: Math.random() * Math.PI * 2
		});
	}

	let time = 0;
	const draw = () => {
		ctx.clearRect(0, 0, w, h);
		time += 0.016;

		// Center glow (pulsing)
		const pulse = 1 + Math.sin(time) * 0.08;
		const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 320 * pulse);
		grad.addColorStop(0, 'rgba(138,140,110,0.07)');
		grad.addColorStop(1, 'rgba(138,140,110,0)');
		ctx.fillStyle = grad;
		ctx.fillRect(0, 0, w, h);

		// Expandable wave rings
		for (let ring = 0; ring < 6; ring++) {
			const ringR = ((time * 45 + ring * 70) % 360) * pulse;
			const ringAlpha = (1 - ringR / 360) * 0.09;
			ctx.beginPath();
			ctx.arc(cx, cy, ringR, 0, Math.PI * 2);
			ctx.strokeStyle = `rgba(138,140,110,${ringAlpha})`;
			ctx.lineWidth = 1.2;
			ctx.stroke();
		}

		// Update + draw particles
		particles.forEach(p => {
			const angle = p.baseAngle + time * p.speed;
			const r = p.baseR + Math.sin(time * 2 + p.baseAngle) * 18;
			p.x = cx + Math.cos(angle) * r;
			p.y = cy + Math.sin(angle) * r;

			// Twinkle
			const tw = 0.5 + Math.sin(time * 3 + p.twinkle) * 0.5;
			const alpha = p.alpha * (0.4 + tw * 0.6);

			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(138,140,110,${alpha})`;
			ctx.fill();
		});

		// Connection lines between close particles
		for (let i = 0; i < particles.length; i++) {
			for (let j = i + 1; j < particles.length; j++) {
				const dx = particles[i].x - particles[j].x;
				const dy = particles[i].y - particles[j].y;
				const dist = Math.sqrt(dx * dx + dy * dy);
				if (dist < 70) {
					const a = (1 - dist / 70) * 0.12;
					ctx.beginPath();
					ctx.moveTo(particles[i].x, particles[i].y);
					ctx.lineTo(particles[j].x, particles[j].y);
					ctx.strokeStyle = `rgba(138,140,110,${a})`;
					ctx.lineWidth = 0.5;
					ctx.stroke();
				}
			}
		}

		requestAnimationFrame(draw);
	};
	draw();
})();

// ═══ Slide observer ═══
(() => {
	const sl = document.getElementById('slideshow');
	const ss = document.querySelectorAll('.slide');
	const ib = document.getElementById('indicator-bar');
	const header = document.getElementById('header');
	if (!sl || !ss.length) return;
	const r = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	ss[0]?.classList.add('is-active');
	if (r) { ss.forEach(s => s.classList.add('is-active')); return; }
	const o = new IntersectionObserver(es => {
		es.forEach(e => {
			if (e.isIntersecting && e.intersectionRatio > 0.5) {
				ss.forEach(s => { if (s !== e.target) s.classList.remove('is-active'); });
				e.target.classList.add('is-active');
				const i = Array.from(ss).indexOf(e.target);
				if (ib) ib.style.height = ((i + 1) / ss.length * 100) + '%';
				// Header scroll state
				if (header) header.classList.toggle('scrolled', i > 0);
			}
		});
	}, { threshold: 0.5 });
	ss.forEach(s => o.observe(s));
})();

// ═══ Number counter animation ═══
(() => {
	const els = document.querySelectorAll('.stat-value[data-target]');
	if (!els.length) return;
	const reduce = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	const fmt = n => n.toLocaleString();
	if (reduce) { els.forEach(el => el.textContent = fmt(parseInt(el.dataset.target || '0', 10) || el.textContent)); return; }

	const seen = new Set();
	const obs = new IntersectionObserver(entries => {
		entries.forEach(entry => {
			if (entry.isIntersecting && !seen.has(entry.target)) {
				seen.add(entry.target);
				const el = entry.target;
				const target = parseInt(el.dataset.target || '0', 10) || 0;
				// Keep the '+' suffix if original text had it
				const suffix = el.textContent.includes('+') ? '+' : '';
				const dur = 1800;
				const start = performance.now();
				const tick = now => {
					const p = Math.min((now - start) / dur, 1);
					const eased = 1 - Math.pow(1 - p, 4); // easeOutQuart
					el.textContent = fmt(Math.floor(target * eased)) + suffix;
					if (p < 1) requestAnimationFrame(tick);
					else el.textContent = fmt(target) + suffix;
				};
				requestAnimationFrame(tick);
			}
		});
	}, { threshold: 0.4 });
	els.forEach(el => obs.observe(el));
})();

// ═══ Gallery 3D tilt ═══
(() => {
	const cards = document.querySelectorAll('.gcard');
	if (!cards.length || matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
	cards.forEach(card => {
		card.addEventListener('mousemove', e => {
			const r = card.getBoundingClientRect();
			const px = (e.clientX - r.left) / r.width - 0.5; // -0.5 .. 0.5
			const py = (e.clientY - r.top) / r.height - 0.5;
			card.style.setProperty('--ry', (px * 14).toFixed(2) + 'deg');
			card.style.setProperty('--rx', (-py * 12).toFixed(2) + 'deg');
			card.classList.add('tilting');
		});
		card.addEventListener('mouseleave', () => {
			card.classList.remove('tilting');
		});
	});
})();

// ═══ Smooth anchor ═══
document.querySelectorAll('a[href^="#"]').forEach(a => {
	a.addEventListener('click', e => { e.preventDefault(); const t = document.querySelector(a.getAttribute('href')); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
});

// ═══ Ring cursor ═══
(() => {
	const ring = document.getElementById('ring-cursor');
	if (!ring || matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
	let mx = 0, my = 0, dx = 0, dy = 0;
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
	document.querySelectorAll('a, button, .group, .tag, .btn').forEach(el => {
		el.addEventListener('mouseenter', () => ring.classList.add('hover'));
		el.addEventListener('mouseleave', () => ring.classList.remove('hover'));
	});
	const tick = () => {
		dx += (mx - dx) * 0.12;
		dy += (my - dy) * 0.12;
		ring.style.left = dx + 'px';
		ring.style.top = dy + 'px';
		requestAnimationFrame(tick);
	};
	tick();
})();
</script>
