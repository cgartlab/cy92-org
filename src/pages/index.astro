---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, PERSONAL_INFO, SKILLS, EXPERIENCE, PROJECTS, STATS, SOCIAL_LINKS, HONORS, WORK_EXPERIENCE, EDUCATION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-canvas">
		<Header />
		<main class="container-custom py-8 md:py-12">
			<!-- Hero Section -->
			<section class="section pb-6 md:pb-8">
				<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 md:gap-8">
					<div class="flex-1">
						<div class="mb-6">
							<h1 class="font-serif text-ink mb-2" style="font-size: 2.5rem; line-height: 1.1;">
								{PERSONAL_INFO.name}
							</h1>
							<p class="text-olive text-base md:text-lg font-medium" style="font-family: var(--font-serif);">
								{PERSONAL_INFO.title}
							</p>
						</div>

						<div class="quote-block my-4">
							<p class="text-sm md:text-base leading-relaxed">
								{PERSONAL_INFO.bio}
							</p>
						</div>

						<div class="flex flex-wrap gap-2 mt-4">
							<span class="tag">
								<Icon name="place" size={14} class="w-3.5 h-3.5" />
								{PERSONAL_INFO.location}
							</span>
							<span class="tag">
								<Icon name="person" size={14} class="w-3.5 h-3.5" />
								{PERSONAL_INFO.personality}
							</span>
						</div>
					</div>

					<div class="flex-shrink-0">
						<div class="w-24 h-24 md:w-28 md:h-28 rounded-xl overflow-hidden border bg-ivory" style="border-color: var(--border-subtle);">
							<img src="/favicon.svg" alt="Logo" class="w-full h-full object-cover" />
						</div>
					</div>
				</div>

				<!-- Contact & Social -->
				<div class="mt-6 pt-6" style="border-top: 1px solid var(--border-subtle);">
					<div class="flex flex-wrap items-center gap-3">
						<a href={`mailto:${PERSONAL_INFO.email}`} class="btn btn-primary text-sm gap-2">
							<Icon name="mail" size={16} class="w-4 h-4" />
							{PERSONAL_INFO.email}
						</a>
						{SOCIAL_LINKS.slice(0, 4).map(link => (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="social-link"
								title={link.name}
							>
								<span class="sr-only">{link.name}</span>
								<Icon name={link.icon} size={18} class="w-[18px] h-[18px]" fill />
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Stats -->
			<section class="py-4 md:py-6">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
					{STATS.map((stat, index) => (
						<div class="card p-4 md:p-5 text-center animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
							<div class="flex items-baseline justify-center gap-1 mb-1">
								<span class="text-2xl md:text-3xl font-medium text-ink" style="font-family: var(--font-serif);">{stat.value}</span>
								<span class="text-sm text-stone">{stat.unit}</span>
							</div>
							<p class="text-xs text-olive">{stat.label}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Skills -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">专业技能</h2>
					<div class="section-line"></div>
				</div>

				<div class="grid md:grid-cols-2 gap-4 md:gap-5">
					{SKILLS.map(category => (
						<div class="card p-5">
							<h3 class="text-sm font-medium text-ink mb-3" style="font-family: var(--font-serif);">{category.category}</h3>
							<div class="flex flex-wrap gap-2">
								{category.items.map(skill => (
									<span class="tag">{skill}</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Education -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">教育经历</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{EDUCATION.map(edu => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium text-ink mb-1" style="font-family: var(--font-serif);">{edu.period}</div>
								<div>
									<h3 class="text-base font-medium text-foreground mb-0.5">{edu.school}</h3>
									<p class="text-sm text-ink mb-0.5">{edu.major}</p>
									<p class="text-sm text-olive">{edu.degree}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Work Experience -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">工作经历</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{WORK_EXPERIENCE.map(exp => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium text-ink mb-1" style="font-family: var(--font-serif);">{exp.period}</div>
								<div>
									<h3 class="text-base font-medium text-foreground mb-0.5">{exp.title}</h3>
									{exp.department && exp.position && (
										<p class="text-sm text-ink mb-1">{exp.department} · {exp.position}</p>
									)}
									<p class="text-sm text-olive leading-relaxed">{exp.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Honors -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">荣誉与成就</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-4">
						{HONORS.map(honor => (
							<div class="flex gap-4 p-3 rounded-lg bg-canvas">
								<div class="flex-shrink-0 w-14 text-right">
									<span class="text-sm font-medium text-ink" style="font-family: var(--font-serif);">{honor.year}</span>
								</div>
								<div class="flex-1">
									<h3 class="text-sm font-medium text-foreground mb-0.5">{honor.title}</h3>
									<p class="text-xs text-olive leading-relaxed">{honor.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Creative Practice -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">创作实践</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{EXPERIENCE.map(exp => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium text-ink mb-1" style="font-family: var(--font-serif);">{exp.period}</div>
								<div>
									<h3 class="text-base font-medium text-foreground mb-1">{exp.title}</h3>
									<p class="text-sm text-olive leading-relaxed">{exp.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Projects -->
			<section class="section">
				<div class="section-header">
					<h2 class="section-title">项目作品</h2>
					<div class="section-line"></div>
				</div>

				<div class="grid md:grid-cols-2 gap-4 md:gap-5">
					{PROJECTS.map(project => (
						<article class="card p-5 group">
							<div class="flex items-start justify-between gap-3 mb-3">
								<h3 class="text-base font-medium text-foreground group-hover:text-ink transition-colors" style="font-family: var(--font-serif);">
									{project.title}
								</h3>
								<a
									href={project.link}
									target="_blank"
									rel="noopener noreferrer"
									class="flex-shrink-0 text-stone hover:text-ink transition-colors"
								>
									<Icon name="open_in_new" size={16} class="w-4 h-4" />
								</a>
							</div>

							<p class="text-sm text-olive leading-relaxed mb-4">{project.description}</p>

							<div class="flex flex-wrap gap-2">
								{project.tags.map(tag => (
									<span class="tag text-xs">{tag}</span>
								))}
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
