---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, PERSONAL_INFO, SKILLS, EXPERIENCE, STATS, SOCIAL_LINKS, HONORS, WORK_EXPERIENCE, EDUCATION } from '../consts';

const coverImage = '/images/冥想系列-cover.webp';
const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 2014;
const meditationImages = [
	{ src: '/images/冥想系列-1754664750528.webp', title: '冥想系列 1', desc: '早期冥想探索，意识的初次解剖' },
	{ src: '/images/冥想系列-1754664757458.webp', title: '冥想系列 2', desc: '内心对话，矛盾与冲突的视觉化' },
	{ src: '/images/冥想系列-1754664764581.webp', title: '冥想系列 3', desc: '繁重压迫下的精神释放' },
	{ src: '/images/冥想系列-1754664772045.webp', title: '冥想系列 4', desc: '对立统一，真实的自我映射' },
	{ src: '/images/冥想系列-1754664780351.webp', title: '冥想系列 5', desc: '意识深处的宁静与动荡' },
	{ src: '/images/冥想系列-1754664786331.webp', title: '冥想系列 6', desc: '精神世界的数字重构' },
	{ src: '/images/冥想系列-1754664798635.webp', title: '冥想系列 7', desc: '内在探索的第七阶段' },
	{ src: '/images/冥想系列-1754664814920.webp', title: '冥想系列 8', desc: '接近实相的道路' },
	{ src: '/images/冥想系列-1754664822895.webp', title: '冥想系列 9', desc: '意识的最终形态' },
	{ src: '/images/冥想系列-1754664829706.webp', title: '冥想系列 10', desc: '冥想之旅的终点与起点' }
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={PERSONAL_INFO.description} />
	</head>
	<body>

		<!-- Global ring cursor -->
		<div class="ring-cursor" id="ring-cursor"></div>

		<!-- ═══ Immersive Header ═══ -->
		<header class="header" id="header">
			<a href="/" class="header-logo">{SITE_TITLE.split(' | ')[0]}</a>
			<nav class="header-nav">
				<a href="#work" class="header-link">Work</a>
				<a href="#profile" class="header-link">Profile</a>
				<a href="#contact" class="header-link">Contact</a>
			</nav>
			<a href={`mailto:${PERSONAL_INFO.email}`} class="header-email">hello@cgartlab.com</a>
		</header>

		<!-- ═══ Slideshow ═══ -->
		<main id="slideshow" class="slideshow">

			<!-- ═══ Slide 0 — Hero (Seaweed particles) ═══ -->
			<section class="slide dark" data-slide="0">
				<canvas id="seaweed" class="canvas-full"></canvas>
				<div class="slide-content center">
					<div class="hero">
						<h1 class="hero-name anim" data-d="0">CHEN<br>YANG</h1>
						<p class="hero-role anim" data-d="1">A Designer, Writer, Engineer.</p>
						<p class="hero-tags anim" data-d="2">动态视觉设计师 · 内容创作者 · 产品工程师</p>
						<a href="#work" class="btn anim" data-d="3">探索作品 <Icon name="arrow_downward" size={16} class="w-4 h-4" /></a>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 1 — Stats ═══ -->
			<section class="slide dark" data-slide="1">
				<div class="slide-content center">
					<div class="stats">
						<div class="stat anim" data-d="0">
							<span class="stat-label">累计发表字数</span>
							<span class="stat-value">187,979</span>
							<span class="stat-unit">字</span>
						</div>
						<div class="stat anim" data-d="1">
							<span class="stat-label">过去一年提交代码</span>
							<span class="stat-value">5,565</span>
							<span class="stat-unit">次</span>
						</div>
						<div class="stat anim" data-d="2">
							<span class="stat-label">致力于数字创作领域</span>
							<span class="stat-value">{yearsActive}</span>
							<span class="stat-unit">年</span>
						</div>
						<div class="stat anim" data-d="3">
							<span class="stat-label">跨领域专业项目</span>
							<span class="stat-value">50+</span>
							<span class="stat-unit">个</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 2 — What I do (video bg -30%, fixed) ═══ -->
			<section class="slide" data-slide="2">
				<video id="shared-video" autoplay muted loop playsinline class="video-fixed" style="filter:brightness(0.3)">
					<source src="/video/demo.mp4" type="video/mp4" />
				</video>
				<div class="slide-content">
					<div class="split">
						<div class="split-left">
							<p class="label anim" data-d="0">What I do</p>
							<h2 class="heading-xl anim" data-d="1">跨领域<br>数字创作者</h2>
							<p class="body anim" data-d="2">
								我创建数字产品、塑造品牌视觉、分享创作背后的思考过程。倡导数据主权，坚持创作即认知的理念。
							</p>
						</div>
						<div class="split-right">
							<div class="skills">
								{SKILLS.map((category, i) => (
									<div class="skill anim" data-d={i + 2}>
										<h3 class="skill-cat">{category.category}</h3>
										<ul class="skill-list">
											{category.items.map(s => <li>{s}</li>)}
										</ul>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 3 — Featured Work (video bg +70%, light text) ═══ -->
			<section class="slide" data-slide="3" id="work">
				<div class="video-overlay" style="filter:brightness(0.7)"></div>
				<div class="slide-content">
					<div class="work">
						<p class="label anim" data-d="0">Featured Work</p>
						<h2 class="heading-xl anim" data-d="1">本科动画毕业十年后的作品集</h2>
						<p class="body-lg anim" data-d="2">
							四年一度的作品集更新，涵盖三维动画、CG艺术、手绘等多种创作形式。展示了从2016年毕业至今的创作历程与艺术探索，记录了从学生到职业创作者的完整转变。
						</p>
						<p class="body anim" data-d="3">
							从早期的实验性VR数字艺术作品《Hello World 2.0》，到为央视《2025 CCTV品牌强国工程发布会》制作的开场片动效，再到入选CCG EXPO的《COVID-19》——每一件作品都是对创作边界的探索与突破。
						</p>
						<div class="tags anim" data-d="4">
							<span class="tag">2024</span>
							<span class="tag">三维动画</span>
							<span class="tag">CG艺术</span>
							<span class="tag">作品集</span>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 4 — Meditation (cover infinite, light text) ═══ -->
			<section class="slide" data-slide="4">
				<img src={coverImage} alt="冥想系列" class="img-bg" style="filter:brightness(0.45)" />
				<div class="slide-content">
					<div class="meditation">
						<div class="med-text">
							<p class="label anim" data-d="0">Meditation Series</p>
							<h2 class="heading-display anim" data-d="1">冥想系列</h2>
							<p class="body anim" data-d="2">
								冥想是一种改变意识的形式，是解剖自己内心的过程。在接下来的几年里我用自己的业余时间创作了这个系列，每一幅作品都聊到了我经历的不同阶段。
							</p>
							<a href="https://cgartlab.com/posts/meditation-series/" target="_blank" rel="noopener noreferrer" class="btn anim" data-d="3">
								查看全部作品 <Icon name="arrow_forward" size={16} class="w-4 h-4" />
							</a>
						</div>
						<div class="med-strip anim" data-d="2">
							<div class="strip-track">
								{[...meditationImages, ...meditationImages, ...meditationImages].map(img => (
									<div class="strip-item">
										<img src={img.src} alt={img.title} class="strip-img" />
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 5 — Gallery 3D ═══ -->
			<section class="slide dark" data-slide="5">
				<div class="slide-content center">
					<div class="gallery-wrap">
						<p class="label anim" data-d="0" style="text-align:center">Gallery</p>
						<div class="gallery-3d">
							{meditationImages.map((img, i) => (
								<div class="gcard anim" data-d={i % 5} style={`--i:${i}`}>
									<img src={img.src} alt={img.title} class="gcard-img" />
									<div class="gcard-info">
										<h3 class="gcard-title">{img.title}</h3>
										<p class="gcard-desc">{img.desc}</p>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 6 — Profile (mobile optimized) ═══ -->
			<section class="slide dark" data-slide="6" id="profile">
				<div class="slide-content scroll-y">
					<div class="profile">
						<div class="profile-left">
							<p class="label anim" data-d="0">About</p>
							<h2 class="heading-lg anim" data-d="1">画画是画画的酬劳，写作是写作的回报。</h2>
							<p class="body anim" data-d="2">INFJ型人格，目前居住在云南昆明。倡导数据主权，坚持创作即认知的理念。</p>
							<p class="body anim" data-d="3">「数据主权」是我价值体系的核心。「创作即认知」——写作的根本目的在于梳理思维、认识自我。</p>
							<div class="profile-contact anim" data-d="4">
								<p class="label-sm">Contact</p>
								<div class="contact-row">
									{SOCIAL_LINKS.slice(0, 4).map(link => (
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link" title={link.name}>
											<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
										</a>
									))}
								</div>
							</div>
						</div>
						<div class="profile-right">
							<section class="psection anim" data-d="1">
								<h3 class="label-sm">工作经历</h3>
								{WORK_EXPERIENCE.map(exp => (
									<div class="exp">
										<span class="exp-period">{exp.period}</span>
										<div>
											<h4 class="exp-title">{exp.title}</h4>
											<p class="exp-desc">{exp.description}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim" data-d="2">
								<h3 class="label-sm">教育经历</h3>
								{EDUCATION.map(edu => (
									<div class="exp">
										<span class="exp-period">{edu.period}</span>
										<div>
											<h4 class="exp-title">{edu.school}</h4>
											<p class="exp-accent">{edu.major}</p>
										</div>
									</div>
								))}
							</section>
							<section class="psection anim" data-d="3">
								<h3 class="label-sm">Honors</h3>
								<div class="honors">
									{HONORS.slice(0, 4).map(h => (
										<div class="honor">
											<span class="honor-year">{h.year}</span>
											<h4 class="honor-title">{h.title}</h4>
										</div>
									))}
								</div>
							</section>
							<section class="psection anim" data-d="4">
								<h3 class="label-sm">Creative Practice</h3>
								<div class="practice">
									{EXPERIENCE.map(exp => (
										<div class="practice-card">
											<span class="practice-period">{exp.period}</span>
											<h4 class="practice-title">{exp.title}</h4>
											<p class="practice-desc">{exp.description}</p>
										</div>
									))}
								</div>
							</section>
						</div>
					</div>
				</div>
			</section>

			<!-- ═══ Slide 7 — Contact (wave particles) ═══ -->
			<section class="slide dark" data-slide="7" id="contact">
				<canvas id="waves" class="canvas-full"></canvas>
				<div class="slide-content center">
					<div class="contact">
						<p class="label anim" data-d="0">Get in Touch</p>
						<h2 class="heading-xl anim" data-d="1">Let's work together</h2>
						<p class="body anim" data-d="2">如果你对我的作品感兴趣，或者有任何合作想法，欢迎随时联系我。</p>
						<div class="contact-actions anim" data-d="3">
							<a href={`mailto:${PERSONAL_INFO.email}`} class="btn"><Icon name="mail" size={16} class="w-4 h-4" />{PERSONAL_INFO.email}</a>
							{SOCIAL_LINKS.slice(0, 4).map(link => (
								<a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-link-lg" title={link.name}>
									<Icon name={link.icon} size={16} class="w-4 h-4" fill />
								</a>
							))}
						</div>
					</div>
				</div>
			</section>

		</main>

		<!-- ═══ Footer ═══ -->
		<footer class="footer">
			<div class="footer-divider"></div>
			<div class="footer-inner">
				<div class="footer-left">
					<span>&copy; {currentYear} ChenYang</span>
					<span class="dot">·</span>
					<span class="footer-text">画画是画画的酬劳，写作是写作的回报。</span>
				</div>
				<div class="footer-right">
					{SOCIAL_LINKS.map(link => (
						<a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-link" title={link.name}>
							<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
						</a>
					))}
				</div>
			</div>
		</footer>

		<!-- Indicator -->
		<div class="indicator"><div class="indicator-bar" id="indicator-bar"></div></div>

	</body>
</html>

<style>
/* ══════════════════════════════════════════════
   Design Tokens
══════════════════════════════════════════════ */
:root {
	--bg: #0a0a0a;
	--surface: #141414;
	--elevated: #1e1e1e;
	--text: #FAF9F6;
	--text-2: #d4d2cc;
	--text-3: #a0a098;
	--text-4: #707068;
	--accent: var(--ds-accent, #8A8C6E);
	--border: rgba(255,255,255,0.08);
	--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; }
body { background: var(--bg); color: var(--text); font-family: var(--ds-font-body, 'Inter', 'Noto Sans SC', system-ui, sans-serif); -webkit-font-smoothing: antialiased; cursor: none; }
a, button { cursor: none; }

/* ═══ Ring Cursor ═══ */
.ring-cursor {
	position: fixed; width: 32px; height: 32px;
	border: 1.5px solid rgba(255,255,255,0.5);
	border-radius: 50%; pointer-events: none; z-index: 9999;
	transition: transform 0.2s var(--spring), border-color 0.3s, width 0.3s var(--spring), height 0.3s var(--spring);
	transform: translate(-50%, -50%);
	mix-blend-mode: difference;
}
.ring-cursor.hover { width: 56px; height: 56px; border-color: var(--accent); }

/* ═══ Typography ═══ */
.heading-display { font-size: clamp(3rem, 10vw, 7rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 700; }
.heading-xl { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.04em; font-weight: 700; }
.heading-lg { font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.2; letter-spacing: -0.03em; font-weight: 600; }
.body-lg { font-size: 1.125rem; line-height: 1.7; }
.body { font-size: 0.9375rem; line-height: 1.7; color: var(--text-2); }
.body-sm { font-size: 0.8125rem; line-height: 1.6; color: var(--text-3); }
.label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); font-weight: 500; }
.label-sm { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); font-weight: 500; margin-bottom: 1rem; }

/* ═══ Header ═══ */
.header {
	position: fixed; top: 0; left: 0; right: 0; z-index: 200;
	display: flex; align-items: center; justify-content: space-between;
	padding: 1.25rem 1.5rem; pointer-events: none;
	border-bottom: 1px solid transparent;
	transition: border-color 0.3s, background 0.3s;
}
.header.scrolled { border-bottom-color: var(--border); background: rgba(10,10,10,0.8); backdrop-filter: blur(12px); }
.header > * { pointer-events: auto; }
.header-logo { font-size: 0.875rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: -0.02em; }
.header-nav { display: flex; gap: 1.5rem; }
.header-link { font-size: 0.65rem; color: var(--text-4); text-decoration: none; text-transform: uppercase; letter-spacing: 0.12em; transition: color 0.3s; }
.header-link:hover { color: var(--text); }
.header-email { font-size: 0.65rem; color: var(--text-4); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s; }
.header-email:hover { color: var(--text); }
@media (max-width: 767px) { .header-email { display: none; } }

/* ═══ Canvas / Video ═══ */
.canvas-full { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.video-fixed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; z-index: 0; }
.video-overlay { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; z-index: 0; background: var(--bg); }
.img-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

/* ═══ Slideshow ═══ */
.slideshow { height: 100vh; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; scrollbar-width: none; }
.slideshow::-webkit-scrollbar { display: none; }
.slide { position: relative; width: 100%; min-height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; }
.dark { background: var(--bg); }
.slide-content { position: relative; z-index: 1; display: flex; align-items: center; width: 100%; min-height: 100vh; padding: 5rem 1.5rem; }
.slide-content.center { justify-content: center; }
.slide-content.scroll-y { align-items: flex-start; overflow-y: auto; }
@media (min-width: 768px) { .slide-content { padding: 5rem 3rem; } }

.center { text-align: center; }

/* ═══ Hero ═══ */
.hero { max-width: 900px; }
.hero-name {
	font-size: clamp(5rem, 18vw, 16rem);
	line-height: 0.85;
	letter-spacing: -0.06em;
	font-weight: 700;
	margin-bottom: 1rem;
}
.hero-role { font-size: clamp(1.125rem, 2.5vw, 1.75rem); color: var(--text-3); letter-spacing: -0.02em; margin-bottom: 0.75rem; }
.hero-tags { font-size: 0.875rem; color: var(--text-4); letter-spacing: 0.02em; margin-bottom: 2rem; }

/* ═══ Stats ═══ */
.stats { width: 100%; max-width: 800px; display: flex; flex-direction: column; gap: 0; }
.stat {
	display: flex; align-items: baseline; gap: 1rem;
	border-bottom: 1px solid var(--border);
	padding: 1.5rem 0;
	text-align: left;
	justify-content: space-between;
}
.stat:first-child { border-top: 1px solid var(--border); }
.stat-label { font-size: 0.875rem; color: var(--text-3); flex-shrink: 0; }
.stat-value { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.85; letter-spacing: -0.05em; font-weight: 700; text-align: right; }
.stat-unit { font-size: 1rem; color: var(--text-4); }

/* ═══ Split ═══ */
.split { display: grid; grid-template-columns: 1fr; gap: 2.5rem; width: 100%; }
@media (min-width: 1024px) { .split { grid-template-columns: 5fr 7fr; gap: 4rem; } }
.split-left { max-width: 480px; }
.split-left .heading-xl { margin-bottom: 1rem; }
.skills { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.skill-cat { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); margin-bottom: 0.75rem; }
.skill-list { list-style: none; padding: 0; }
.skill-list li { font-size: 0.875rem; color: var(--text-2); line-height: 1.8; }

/* ═══ Work ═══ */
.work { max-width: 640px; }
.work .heading-xl { margin: 0.5rem 0 1rem; }
.work .body-lg { color: var(--text-2); margin-bottom: 1rem; }
.work .body { margin-bottom: 1.5rem; }
.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tag { padding: 4px 12px; font-size: 0.7rem; background: rgba(255,255,255,0.06); color: var(--text-3); border: 1px solid var(--border); transition: all 0.3s var(--spring); }
.tag:hover { background: rgba(255,255,255,0.1); color: var(--text); border-color: rgba(255,255,255,0.15); }

/* ═══ Meditation ═══ */
.meditation { display: grid; grid-template-columns: 1fr; gap: 2.5rem; width: 100%; align-items: center; }
@media (min-width: 768px) { .meditation { grid-template-columns: 1fr 1fr; } }
.med-text { max-width: 420px; }
.med-strip { overflow: hidden; width: 100%; }
.strip-track { display: flex; gap: 0.25rem; animation: scroll 30s linear infinite; }
.strip-item { flex-shrink: 0; width: 140px; height: 140px; overflow: hidden; }
@media (min-width: 768px) { .strip-item { width: 180px; height: 180px; } }
.strip-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--spring); }
.strip-item:hover .strip-img { transform: scale(1.1); }
@keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-33.333%); } }

/* ═══ Gallery 3D ═══ */
.gallery-wrap { width: 100%; }
.gallery-3d { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; padding: 1.5rem 0; perspective: 1000px; }
.gcard { width: 180px; height: 240px; overflow: hidden; position: relative; transform: rotateY(calc((var(--i) - 5) * 5deg)) translateZ(calc(var(--i) * -10px)); transition: all 0.5s var(--spring); }
@media (min-width: 768px) { .gcard { width: 220px; height: 280px; } }
.gcard:hover { transform: rotateY(0) translateZ(30px) scale(1.05); box-shadow: 0 20px 50px rgba(0,0,0,0.4); z-index: 10; }
.gcard-img { width: 100%; height: 100%; object-fit: cover; }
.gcard-info { position: absolute; bottom: 0; left: 0; right: 0; padding: 1rem; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); opacity: 0; transition: opacity 0.4s; }
.gcard:hover .gcard-info { opacity: 1; }
.gcard-title { font-size: 0.875rem; font-weight: 600; color: var(--text); margin-bottom: 0.25rem; }
.gcard-desc { font-size: 0.75rem; color: var(--text-3); line-height: 1.5; }

/* ═══ Profile ═══ */
.profile { display: grid; grid-template-columns: 1fr; gap: 2.5rem; width: 100%; }
@media (min-width: 1024px) { .profile { grid-template-columns: 4fr 8fr; gap: 3rem; } }
.profile-contact { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
.contact-row { display: flex; gap: 0.5rem; }
.icon-link { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 1px solid var(--border); color: var(--text-4); text-decoration: none; transition: all 0.3s var(--spring); }
.icon-link:hover { border-color: var(--text); color: var(--text); }

.psection { margin-bottom: 2rem; }
.exp { display: flex; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.exp-period { font-size: 0.75rem; color: var(--text-4); width: 80px; flex-shrink: 0; padding-top: 2px; }
.exp-title { font-size: 0.9375rem; font-weight: 500; color: var(--text); }
.exp-desc { font-size: 0.8125rem; color: var(--text-3); line-height: 1.6; margin-top: 0.25rem; }
.exp-accent { font-size: 0.8125rem; color: var(--accent); margin-top: 0.25rem; }

.honors { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.honor { padding: 1rem; background: var(--surface); }
.honor-year { font-size: 0.75rem; color: var(--accent); }
.honor-title { font-size: 0.8125rem; color: var(--text); margin-top: 0.25rem; line-height: 1.5; font-weight: 500; }

.practice { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); }
@media (min-width: 768px) { .practice { grid-template-columns: 1fr 1fr 1fr; } }
.practice-card { padding: 1.25rem; background: var(--bg); }
.practice-period { font-size: 0.75rem; color: var(--accent); }
.practice-title { font-size: 0.875rem; font-weight: 500; color: var(--text); margin: 0.25rem 0 0.5rem; }
.practice-desc { font-size: 0.75rem; color: var(--text-3); line-height: 1.6; }

/* ═══ Contact ═══ */
.contact { max-width: 500px; }
.contact .heading-xl { margin: 0.5rem 0 1rem; }
.contact .body { margin-bottom: 2rem; }
.contact-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; }
.icon-link-lg { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border); color: var(--text-4); text-decoration: none; transition: all 0.3s var(--spring); }
.icon-link-lg:hover { border-color: var(--text); color: var(--text); transform: scale(1.1); }

/* ═══ Button ═══ */
.btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-size: 0.875rem; font-weight: 500; background: var(--text); color: var(--bg); text-decoration: none; transition: transform 0.4s var(--spring), background 0.3s; }
.btn:hover { background: #fff; transform: scale(1.05); }

/* ═══ Footer ═══ */
.footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 150; pointer-events: none; }
.footer-divider { height: 1px; background: var(--border); margin: 0 1.5rem; }
.footer-inner { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.5rem; pointer-events: auto; }
.footer-left { display: flex; align-items: center; gap: 0.5rem; font-size: 0.7rem; color: var(--text-4); }
.dot { color: var(--accent); }
.footer-text { display: none; }
@media (min-width: 768px) { .footer-text { display: inline; } }
.footer-right { display: flex; gap: 0.75rem; }
.footer-link { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; color: var(--text-4); text-decoration: none; transition: color 0.3s; }
.footer-link:hover { color: var(--text); }

/* ═══ Indicator ═══ */
.indicator { position: fixed; right: 1rem; top: 50%; transform: translateY(-50%); width: 2px; height: 80px; background: rgba(255,255,255,0.05); border-radius: 1px; z-index: 100; overflow: hidden; }
.indicator-bar { width: 100%; height: 0%; background: var(--accent); border-radius: 1px; transition: height 0.4s var(--spring); }

/* ═══ Animations ═══ */
.anim { opacity: 0; transform: translateY(24px); }
.slide.is-active .anim { animation: fadeUp 0.6s var(--spring) forwards; }
.slide.is-active .anim[data-d="0"] { animation-delay: 0.05s; }
.slide.is-active .anim[data-d="1"] { animation-delay: 0.12s; }
.slide.is-active .anim[data-d="2"] { animation-delay: 0.2s; }
.slide.is-active .anim[data-d="3"] { animation-delay: 0.28s; }
.slide.is-active .anim[data-d="4"] { animation-delay: 0.36s; }
.slide.is-active .anim[data-d="5"] { animation-delay: 0.44s; }
.slide.is-active .anim[data-d="6"] { animation-delay: 0.52s; }
.slide.is-active .anim[data-d="7"] { animation-delay: 0.6s; }
.slide.is-active .anim[data-d="8"] { animation-delay: 0.68s; }

@keyframes fadeUp {
	from { opacity: 0; transform: translateY(24px); }
	to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
	.slideshow { scroll-behavior: auto; scroll-snap-type: none; }
	.slide.is-active .anim { opacity: 1; transform: none; animation: none; }
	.strip-track { animation: none; }
	.ring-cursor { display: none; }
	body { cursor: auto; }
	a, button { cursor: pointer; }
}
</style>

<script>
// ═══ Seaweed particles (Hero) ═══
(() => {
	const c = document.getElementById('seaweed');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const lines = [];
	const LINE_COUNT = 24;
	let mx = -999, my = -999;

	const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; };
	resize();
	addEventListener('resize', resize);
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });

	for (let i = 0; i < LINE_COUNT; i++) {
		lines.push({
			x: (i / LINE_COUNT) * w + Math.random() * 40,
			points: Array.from({ length: 20 }, (_, j) => ({
				y: (j / 20) * h,
				offset: Math.random() * Math.PI * 2
			})),
			hue: 80 + Math.random() * 20,
			speed: 0.3 + Math.random() * 0.3,
			phase: Math.random() * Math.PI * 2
		});
	}

	let time = 0;
	const draw = () => {
		ctx.clearRect(0, 0, w, h);
		time += 0.01;

		lines.forEach(line => {
			ctx.beginPath();
			line.points.forEach((p, j) => {
				const sway = Math.sin(time * line.speed + p.offset + line.phase) * (20 + j * 2);
				const dx = mx - line.x;
				const dy = my - p.y;
				const dist = Math.sqrt(dx * dx + dy * dy);
				const glow = dist < 200 ? (1 - dist / 200) * 30 : 0;
				const x = line.x + sway + glow * (dx / dist || 0);
				const y = p.y;
				if (j === 0) ctx.moveTo(x, y);
				else ctx.lineTo(x, y);
			});

			const grad = ctx.createLinearGradient(line.x, 0, line.x, h);
			grad.addColorStop(0, `hsla(${line.hue}, 30%, 45%, 0.02)`);
			grad.addColorStop(0.3, `hsla(${line.hue}, 30%, 45%, 0.15)`);
			grad.addColorStop(0.7, `hsla(${line.hue}, 30%, 45%, 0.15)`);
			grad.addColorStop(1, `hsla(${line.hue}, 30%, 45%, 0.02)`);
			ctx.strokeStyle = grad;
			ctx.lineWidth = 2;
			ctx.stroke();

			// Mouse glow
			if (mx > 0) {
				line.points.forEach(p => {
					const dx = mx - line.x;
					const dy = my - p.y;
					const dist = Math.sqrt(dx * dx + dy * dy);
					if (dist < 150) {
						const alpha = (1 - dist / 150) * 0.4;
						ctx.beginPath();
						ctx.arc(line.x + Math.sin(time * line.speed + p.offset) * 10, p.y, 3, 0, Math.PI * 2);
						ctx.fillStyle = `rgba(138,140,110,${alpha})`;
						ctx.fill();
					}
				});
			}
		});

		requestAnimationFrame(draw);
	};
	draw();
})();

// ═══ Wave particles (Contact) ═══
(() => {
	const c = document.getElementById('waves');
	if (!c) return;
	const ctx = c.getContext('2d');
	if (!ctx) return;
	let w, h;
	const particles = [];
	const N = 120;

	const resize = () => { w = c.width = innerWidth; h = c.height = innerHeight; };
	resize();
	addEventListener('resize', resize);

	for (let i = 0; i < N; i++) {
		const angle = (i / N) * Math.PI * 2;
		const r = 50 + Math.random() * 200;
		particles.push({
			baseAngle: angle,
			baseR: r,
			x: w / 2 + Math.cos(angle) * r,
			y: h / 2 + Math.sin(angle) * r,
			speed: 0.002 + Math.random() * 0.003,
			r: 1 + Math.random() * 2,
			alpha: 0.1 + Math.random() * 0.3
		});
	}

	let time = 0;
	const draw = () => {
		ctx.clearRect(0, 0, w, h);
		time += 0.015;

		// Center glow
		const grad = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, 300);
		grad.addColorStop(0, 'rgba(138,140,110,0.05)');
		grad.addColorStop(1, 'rgba(138,140,110,0)');
		ctx.fillStyle = grad;
		ctx.fillRect(0, 0, w, h);

		// Wave rings
		for (let ring = 0; ring < 5; ring++) {
			const ringR = ((time * 40 + ring * 60) % 300);
			const ringAlpha = (1 - ringR / 300) * 0.08;
			ctx.beginPath();
			ctx.arc(w / 2, h / 2, ringR, 0, Math.PI * 2);
			ctx.strokeStyle = `rgba(138,140,110,${ringAlpha})`;
			ctx.lineWidth = 1;
			ctx.stroke();
		}

		// Particles
		particles.forEach(p => {
			const angle = p.baseAngle + time * p.speed;
			const r = p.baseR + Math.sin(time * 2 + p.baseAngle) * 15;
			p.x = w / 2 + Math.cos(angle) * r;
			p.y = h / 2 + Math.sin(angle) * r;

			ctx.beginPath();
			ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(138,140,110,${p.alpha})`;
			ctx.fill();
		});

		requestAnimationFrame(draw);
	};
	draw();
})();

// ═══ Slide observer ═══
(() => {
	const sl = document.getElementById('slideshow');
	const ss = document.querySelectorAll('.slide');
	const ib = document.getElementById('indicator-bar');
	const header = document.getElementById('header');
	if (!sl || !ss.length) return;
	const r = matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	ss[0]?.classList.add('is-active');
	if (r) { ss.forEach(s => s.classList.add('is-active')); return; }
	const o = new IntersectionObserver(es => {
		es.forEach(e => {
			if (e.isIntersecting && e.intersectionRatio > 0.5) {
				ss.forEach(s => { if (s !== e.target) s.classList.remove('is-active'); });
				e.target.classList.add('is-active');
				const i = Array.from(ss).indexOf(e.target);
				if (ib) ib.style.height = ((i + 1) / ss.length * 100) + '%';
				// Header scroll state
				if (header) header.classList.toggle('scrolled', i > 0);
			}
		});
	}, { threshold: 0.5 });
	ss.forEach(s => o.observe(s));
})();

// ═══ Smooth anchor ═══
document.querySelectorAll('a[href^="#"]').forEach(a => {
	a.addEventListener('click', e => { e.preventDefault(); const t = document.querySelector(a.getAttribute('href')); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
});

// ═══ Ring cursor ═══
(() => {
	const ring = document.getElementById('ring-cursor');
	if (!ring || matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
	let mx = 0, my = 0, dx = 0, dy = 0;
	addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
	document.querySelectorAll('a, button, .group, .tag, .btn').forEach(el => {
		el.addEventListener('mouseenter', () => ring.classList.add('hover'));
		el.addEventListener('mouseleave', () => ring.classList.remove('hover'));
	});
	const tick = () => {
		dx += (mx - dx) * 0.12;
		dy += (my - dy) * 0.12;
		ring.style.left = dx + 'px';
		ring.style.top = dy + 'px';
		requestAnimationFrame(tick);
	};
	tick();
})();
</script>
