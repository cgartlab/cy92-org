---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, PERSONAL_INFO, SKILLS, EXPERIENCE, PROJECTS, STATS, SOCIAL_LINKS, HONORS, WORK_EXPERIENCE, EDUCATION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen" style="background: var(--ds-color-bg); color: var(--ds-color-fg);">
		<Header />
		<main class="container-custom py-8 md:py-12">
			<!-- Hero Section -->
			<section class="section pb-8 md:pb-10">
				<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 md:gap-10">
					<div class="flex-1 min-w-0">
						<div class="mb-6">
							<span class="ds-eyebrow mb-3">跨领域数字创作者</span>
							<h1 class="ds-gradient-text" style="font-family: var(--ds-font-display); font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.08; letter-spacing: var(--ds-tracking-tight);">
								{PERSONAL_INFO.name}
							</h1>
						</div>

						<div class="quote-block my-5">
							<p class="leading-relaxed" style="font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);">
								{PERSONAL_INFO.bio}
							</p>
						</div>

						<div class="flex flex-wrap gap-2 mt-5">
							<span class="tag">
								<Icon name="place" size={14} class="w-3.5 h-3.5" />
								{PERSONAL_INFO.location}
							</span>
							<span class="tag">
								<Icon name="person" size={14} class="w-3.5 h-3.5" />
								{PERSONAL_INFO.personality}
							</span>
						</div>
					</div>

					<div class="flex-shrink-0 flex md:block justify-center">
						<div class="logo-mark ds-anim-float w-28 h-28 md:w-32 md:h-32">
							<img src="/favicon.svg" alt="CG艺术实验室" class="w-full h-full object-cover" />
						</div>
					</div>
				</div>

				<!-- Contact & Social -->
				<div class="mt-8 pt-6" style="border-top: 1px solid var(--ds-color-border-subtle);">
					<div class="flex flex-wrap items-center gap-3">
						<a href={`mailto:${PERSONAL_INFO.email}`} class="btn btn-primary text-sm gap-2">
							<Icon name="mail" size={16} class="w-4 h-4" />
							{PERSONAL_INFO.email}
						</a>
						{SOCIAL_LINKS.slice(0, 4).map(link => (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="social-link"
								title={link.name}
							>
								<span class="sr-only">{link.name}</span>
								<Icon name={link.icon} size={18} class="w-[18px] h-[18px]" fill />
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Stats -->
			<section class="section">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					{STATS.map((stat, index) => (
						<div class="stat-card ds-reveal" style={`--d: ${index * 80}ms`}>
							<div class="flex items-baseline justify-center gap-1 mb-1">
								<span class="stat-value">{stat.value}</span>
								<span class="stat-unit">{stat.unit}</span>
							</div>
							<p class="stat-label">{stat.label}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Skills -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">专业技能</h2>
					<div class="section-line"></div>
				</div>

				<div class="grid md:grid-cols-2 gap-4 md:gap-5">
					{SKILLS.map(category => (
						<div class="card p-5">
							<h3 class="text-sm font-medium mb-3" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{category.category}</h3>
							<div class="flex flex-wrap gap-2">
								{category.items.map(skill => (
									<span class="tag">{skill}</span>
								))}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Education -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">教育经历</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{EDUCATION.map(edu => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium mb-1" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{edu.period}</div>
								<div>
									<h3 class="text-base font-medium mb-0.5" style="color: var(--ds-color-fg);">{edu.school}</h3>
									<p class="text-sm mb-0.5" style="color: var(--ds-accent);">{edu.major}</p>
									<p class="text-sm" style="color: var(--ds-color-fg-subtle);">{edu.degree}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Work Experience -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">工作经历</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{WORK_EXPERIENCE.map(exp => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium mb-1" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{exp.period}</div>
								<div>
									<h3 class="text-base font-medium mb-0.5" style="color: var(--ds-color-fg);">{exp.title}</h3>
									{exp.department && exp.position && (
										<p class="text-sm mb-1" style="color: var(--ds-accent);">{exp.department} · {exp.position}</p>
									)}
									<p class="text-sm leading-relaxed" style="color: var(--ds-color-fg-subtle);">{exp.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Honors -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">荣誉与成就</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-4">
						{HONORS.map(honor => (
							<div class="flex gap-4 p-3 rounded-lg" style="background: var(--ds-color-surface-overlay);">
								<div class="flex-shrink-0 w-14 text-right">
									<span class="text-sm font-medium" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{honor.year}</span>
								</div>
								<div class="flex-1">
									<h3 class="text-sm font-medium mb-0.5" style="color: var(--ds-color-fg);">{honor.title}</h3>
									<p class="text-xs leading-relaxed" style="color: var(--ds-color-fg-subtle);">{honor.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Creative Practice -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">创作实践</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="space-y-0">
						{EXPERIENCE.map(exp => (
							<div class="timeline-item pb-6 last:pb-0">
								<div class="text-sm font-medium mb-1" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{exp.period}</div>
								<div>
									<h3 class="text-base font-medium mb-1" style="color: var(--ds-color-fg);">{exp.title}</h3>
									<p class="text-sm leading-relaxed" style="color: var(--ds-color-fg-subtle);">{exp.description}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Projects -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">项目作品</h2>
					<div class="section-line"></div>
				</div>

				<div class="grid md:grid-cols-2 gap-4 md:gap-5">
					{PROJECTS.map(project => (
						<article class="card p-5 group">
							<div class="flex items-start justify-between gap-3 mb-3">
								<h3 class="text-base font-medium transition-colors" style="font-family: var(--ds-font-display); color: var(--ds-color-fg);">
									{project.title}
								</h3>
								<a
									href={project.link}
									target="_blank"
									rel="noopener noreferrer"
									class="flex-shrink-0 transition-colors"
									style="color: var(--ds-color-muted);"
								>
									<Icon name="open_in_new" size={16} class="w-4 h-4" />
								</a>
							</div>

							<p class="text-sm leading-relaxed mb-4" style="color: var(--ds-color-fg-subtle);">{project.description}</p>

							<div class="flex flex-wrap gap-2">
								{project.tags.map(tag => (
									<span class="tag text-xs">{tag}</span>
								))}
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
