/* Animate when slide becomes active */
.slide.is-active .anim.up { animation: fadeUp 0.7s var(--spring) forwards; }
.slide.is-active .anim.left { animation: fadeLeft 0.7s var(--spring) forwards; }
.slide.is-active .anim.right { animation: fadeRight 0.7s var(--spring) forwards; }
