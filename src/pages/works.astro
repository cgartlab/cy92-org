---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, PERSONAL_INFO } from '../consts';

const meditationImages = [
	{ src: '/images/冥想系列-1754664750528.webp', title: '冥想系列 1' },
	{ src: '/images/冥想系列-1754664757458.webp', title: '冥想系列 2' },
	{ src: '/images/冥想系列-1754664764581.webp', title: '冥想系列 3' },
	{ src: '/images/冥想系列-1754664772045.webp', title: '冥想系列 4' },
	{ src: '/images/冥想系列-1754664780351.webp', title: '冥想系列 5' },
	{ src: '/images/冥想系列-1754664786331.webp', title: '冥想系列 6' },
	{ src: '/images/冥想系列-1754664798635.webp', title: '冥想系列 7' },
	{ src: '/images/冥想系列-1754664814920.webp', title: '冥想系列 8' },
	{ src: '/images/冥想系列-1754664822895.webp', title: '冥想系列 9' },
	{ src: '/images/冥想系列-1754664829706.webp', title: '冥想系列 10' }
];

const coverImage = '/images/冥想系列-cover.webp';

const videoWorks = [
	{
		title: '本科动画毕业十年后的作品集 2020-2024',
		description: '四年一度的作品集更新，涵盖三维动画、CG艺术作品集、手绘等多种创作形式。展示了从2016年毕业至今的创作历程与艺术探索。',
		bilibiliId: 'BV1yyyKYVEeZ',
		year: '2024',
		tags: ['三维动画', 'CG艺术', '作品集']
	},
	{
		title: '个人CG艺术作品集 2016-2020',
		description: '本科动画专业毕业后的首个四年作品集，记录了从学生到职业创作者的转变过程，包含商业项目与个人创作。',
		bilibiliId: 'BV1UK4y1X7rM',
		year: '2020',
		tags: ['CG艺术', '作品集', '毕业作品']
	}
];

const meditationSeries = {
	title: '冥想系列',
	description: '冥想是一种改变意识的形式，是解剖自己内心的过程，是让人无限接近实相的道路。第一次接触这个概念是在2013年，在随后的工作生活中它慢慢变成了我与自己交流的一种习惯。这种奇妙的体验很适合用数字绘画的形式表达出来。在接下来的几年里我用自己的业余时间创作了这个系列，每一幅作品都聊到了我经历的不同阶段，每个阶段我选择不同的主题与自己的内心交谈。从画面上也能感觉到人类底层的内心，绝谈不上美好但也没有那么不堪，繁重的压迫，对立的矛盾，复杂的冲突，都是真实的自己。',
	link: 'https://cgartlab.com/posts/meditation-series/'
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`作品展示 | ${SITE_TITLE}`} description="ChenYang的作品集展示 - 包含CG艺术作品集视频、冥想系列数字绘画等创作成果" />
	</head>
	<body class="min-h-screen" style="background: var(--ds-color-bg); color: var(--ds-color-fg);">
		<Header />
		<main class="container-custom py-8 md:py-12">
			<header class="mb-10 md:mb-12">
				<span class="ds-eyebrow mb-3">Portfolio</span>
				<h1 class="mb-3" style="font-family: var(--ds-font-display); color: var(--ds-color-fg-strong); font-size: 2rem; line-height: 1.15;">作品展示</h1>
				<p class="text-base leading-relaxed max-w-2xl" style="color: var(--ds-color-fg-subtle);">
					创作是内在探索的过程，每一件作品都是与自我对话的记录
				</p>
			</header>

			<!-- CG Art Portfolio -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">CG艺术作品集</h2>
					<div class="section-line"></div>
				</div>

				<div class="space-y-6">
					{videoWorks.map((work, index) => (
						<article class="card overflow-hidden">
							<div class="grid md:grid-cols-2 gap-0">
								<div class="relative aspect-video bg-black">
									<iframe
										src={`//player.bilibili.com/player.html?isOutside=true&aid=&bvid=${work.bilibiliId}&cid=&p=1&highQuality=1&danmaku=0&muted=1&controls=0&autoplay=1`}
										title={work.title}
										class="absolute inset-0 w-full h-full"
										allowfullscreen="true"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									></iframe>
								</div>
								<div class="p-5 md:p-6 flex flex-col justify-center">
									<div class="flex items-center gap-3 mb-3">
										<span class="text-sm font-medium" style="font-family: var(--ds-font-display); color: var(--ds-accent);">{work.year}</span>
										<div class="flex flex-wrap gap-2">
											{work.tags.map(tag => (
												<span class="tag text-xs">{tag}</span>
											))}
										</div>
									</div>
									<h3 class="text-lg font-medium mb-3" style="font-family: var(--ds-font-display); color: var(--ds-color-fg);">{work.title}</h3>
									<p class="text-sm leading-relaxed" style="color: var(--ds-color-fg-subtle);">{work.description}</p>
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<!-- Meditation Series -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">冥想系列 · 数字绘画</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="mb-6">
						<div class="relative w-full aspect-[21/9] overflow-hidden mb-5" style="border-radius: var(--ds-radius-xl);">
							<img
								src={coverImage}
								alt="冥想系列封面"
								class="w-full h-full object-cover"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
							<div class="absolute bottom-4 left-4 right-4">
								<h3 class="text-lg md:text-xl font-medium text-white mb-1" style="font-family: var(--ds-font-display);">{meditationSeries.title}</h3>
								<p class="text-sm text-white/80">数字绘画系列 · 2013-2016</p>
							</div>
						</div>
						<p class="text-sm leading-relaxed" style="color: var(--ds-color-fg-subtle);">
							{meditationSeries.description}
						</p>
					</div>

					<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
						{meditationImages.map((artwork, index) => (
							<a
								href={meditationSeries.link}
								target="_blank"
								rel="noopener noreferrer"
								class="group relative aspect-square overflow-hidden border transition-all duration-300 hover:-translate-y-1"
							style="border-color: var(--ds-color-border-subtle); border-radius: var(--ds-radius-xl);"
							>
								<img
									src={artwork.src}
									alt={artwork.title}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
									<div class="absolute bottom-2 left-2 right-2">
										<span class="text-xs font-medium text-white">{artwork.title}</span>
									</div>
								</div>
							</a>
						))}
					</div>

					<div class="mt-6 pt-4" style="border-top: 1px solid var(--ds-color-border-subtle);">
						<a
							href={meditationSeries.link}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-sm font-medium transition-colors"
							style="color: var(--ds-accent);"
						>
							<span>查看完整冥想系列作品</span>
							<Icon name="open_in_new" size={14} class="w-3.5 h-3.5" />
						</a>
					</div>
				</div>
			</section>

			<!-- More Works -->
			<section class="section ds-reveal">
				<div class="section-header">
					<h2 class="section-title">更多作品</h2>
					<div class="section-line"></div>
				</div>

				<div class="card p-5 md:p-6">
					<div class="grid md:grid-cols-2 gap-4">
						<a
							href="https://space.bilibili.com/cgartlab"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-start gap-4 p-4 rounded-lg transition-colors"
							style="background: var(--ds-color-surface-overlay);"
						>
							<div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center text-white" style="background: var(--ds-accent);">
								<Icon name="bilibili" size={20} class="w-5 h-5" fill />
							</div>
							<div class="flex-1">
								<h3 class="text-sm font-medium mb-1 transition-colors" style="color: var(--ds-color-fg);">Bilibili 主页</h3>
								<p class="text-xs" style="color: var(--ds-color-fg-subtle);">查看更多动画、CG艺术相关视频作品</p>
							</div>
							<Icon name="arrow_forward" size={18} class="flex-shrink-0 transition-all" style="color: var(--ds-color-muted);" />
						</a>

						<a
							href="https://cgartlab.com"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-start gap-4 p-4 rounded-lg transition-colors"
							style="background: var(--ds-color-surface-overlay);"
						>
							<div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center text-white" style="background: var(--ds-accent);">
								<Icon name="brush" size={20} class="w-5 h-5" />
							</div>
							<div class="flex-1">
								<h3 class="text-sm font-medium mb-1 transition-colors" style="color: var(--ds-color-fg);">CG艺术实验室</h3>
								<p class="text-xs" style="color: var(--ds-color-fg-subtle);">访问个人博客，了解更多创作与思考</p>
							</div>
							<Icon name="arrow_forward" size={18} class="flex-shrink-0 transition-all" style="color: var(--ds-color-muted);" />
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
