---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-background">
		<Header />
		<main class="container-custom py-8 md:py-12">
			<h1 class="text-3xl md:text-4xl font-bold text-foreground tracking-tight mb-8 text-center">博客文章</h1>
			
			<div class="grid gap-6 md:grid-cols-2">
				{posts.map((post, index) => (
					<article class={`group ${index === 0 ? 'md:col-span-2' : ''}`}>
						<a 
							href={`/blog/${post.id}/`}
							class="block card overflow-hidden hover:border-primary transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
						>
							{post.data.heroImage && (
								<div class={`relative overflow-hidden ${index === 0 ? 'aspect-[21/9]' : 'aspect-video'}`}>
									<img 
										width={index === 0 ? 1020 : 720}
										height={index === 0 ? 437 : 405}
										src={post.data.heroImage} 
										alt="" 
										loading="lazy"
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								</div>
							)}
							<div class="p-5">
								<h2 class={`font-semibold text-foreground group-hover:text-primary transition-colors mb-2 ${index === 0 ? 'text-2xl md:text-3xl' : 'text-lg'}`}>
									{post.data.title}
								</h2>
								<p class="text-sm text-muted-foreground">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</div>
						</a>
					</article>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
