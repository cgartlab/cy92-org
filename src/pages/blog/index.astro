---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const DEFAULT_COVER = '/default-cover.webp';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen" style="background: var(--ds-color-bg); color: var(--ds-color-fg);">
		<Header />
		<main class="container-custom py-8 md:py-12">
			<header class="mb-10">
				<span class="ds-eyebrow mb-3">Journal</span>
				<h1 class="mb-3" style="font-family: var(--ds-font-display); color: var(--ds-color-fg-strong); font-size: 2rem; line-height: 1.15;">博客文章</h1>
				<p class="text-base" style="color: var(--ds-color-fg-subtle);">思考、创作与探索的记录</p>
			</header>

			{posts.length === 0 ? (
				<div class="card p-8 text-center">
					<p style="color: var(--ds-color-muted);">暂无博客文章</p>
				</div>
			) : (
				<div class="grid gap-6 md:grid-cols-2">
					{posts.map((post, index) => (
						<article class={`group ds-reveal ${index === 0 ? 'md:col-span-2' : ''}`} style={`--d: ${index * 70}ms`}>
							<a
								href={`/blog/${post.id}/`}
								class="block card overflow-hidden transition-all duration-300 hover:-translate-y-1"
							>
								<div class={`relative overflow-hidden ${index === 0 ? 'aspect-[21/9]' : 'aspect-video'}`}>
									<img
										width={index === 0 ? 1020 : 720}
										height={index === 0 ? 437 : 405}
										src={post.data.heroImage || DEFAULT_COVER}
										alt=""
										loading="lazy"
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								</div>
								<div class="p-5">
									<h2 class={`font-medium transition-colors mb-2 ${index === 0 ? 'text-xl md:text-2xl' : 'text-base'}`} style="font-family: var(--ds-font-display); color: var(--ds-color-fg);">
										{post.data.title}
									</h2>
									<p class="text-sm" style="color: var(--ds-color-muted);">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</article>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
