---
interface Props {
	name: string;
	level: number;
}

const { name, level } = Astro.props;

const getLevelColor = (level: number): string => {
	if (level >= 90) return 'from-primary via-primary-light to-primary-dark';
	if (level >= 80) return 'from-primary to-primary-light';
	if (level >= 70) return 'from-primary/60 to-primary';
	return 'from-muted-foreground/30 to-muted-foreground/50';
};

const getLevelLabel = (level: number): string => {
	if (level >= 90) return '精通';
	if (level >= 80) return '熟练';
	if (level >= 70) return '良好';
	return '基础';
};

const getLevelBgColor = (level: number): string => {
	if (level >= 90) return 'bg-primary/10 text-primary';
	if (level >= 80) return 'bg-primary/8 text-primary';
	if (level >= 70) return 'bg-primary/6 text-primary';
	return 'bg-muted-foreground/10 text-muted-foreground';
};
---

<div class="w-full skill-bar group" data-level={level}>
	<div class="flex justify-between items-center mb-2.5">
		<span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors duration-300">{name}</span>
		<div class="flex items-center gap-2">
			<span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${getLevelBgColor(level)}`}>
				{getLevelLabel(level)}
			</span>
			<span class="text-xs text-muted-foreground font-semibold min-w-[40px] text-right">
				{level}%
			</span>
		</div>
	</div>
	<div class="h-2 bg-secondary rounded-full overflow-hidden">
		<div 
			class="h-full rounded-full bg-gradient-to-r progress-bar"
			style={`--progress: ${level}%; --gradient: linear-gradient(90deg, ${getLevelColor(level)})`}
		/>
	</div>
</div>

<style>
	.skill-bar:hover .progress-bar {
		filter: brightness(1.1);
	}
	
	.progress-bar {
		width: 0;
		background: var(--gradient);
		animation: progressFill 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: 0.2s;
		box-shadow: 0 0 10px rgba(27, 54, 93, 0.15);
	}
	
	@keyframes progressFill {
		from {
			width: 0%;
		}
		to {
			width: var(--progress);
		}
	}
	
	@media (prefers-reduced-motion: reduce) {
		.progress-bar {
			animation: none;
			width: var(--progress);
		}
	}
</style>
