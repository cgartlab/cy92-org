---
import Icon from './Icon.astro';

interface Props {
	title: string;
	description: string;
	link: string;
	tags: string[];
}

const { title, description, link, tags } = Astro.props;
---

<article class="card p-5 group">
	<div class="flex items-start justify-between gap-3 mb-3">
		<h3 class="text-base font-medium transition-colors" style="font-family: var(--ds-font-display); color: var(--ds-color-fg);">
			{title}
		</h3>
		<a
			href={link}
			target="_blank"
			rel="noopener noreferrer"
			class="flex-shrink-0 transition-colors"
			style="color: var(--ds-color-muted);"
		>
			<Icon name="open_in_new" size={16} class="w-4 h-4" />
		</a>
	</div>

	<p class="text-sm leading-relaxed mb-4" style="color: var(--ds-color-fg-subtle);">{description}</p>

	<div class="flex flex-wrap gap-2">
		{tags.map(tag => (
			<span class="tag text-xs">{tag}</span>
		))}
	</div>
</article>
