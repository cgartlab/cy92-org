---
import Icon from './Icon.astro';

interface Props {
	title: string;
	description: string;
	link: string;
	tags: string[];
}

const { title, description, link, tags } = Astro.props;
---

<article class="group relative bg-card/80 backdrop-blur-sm rounded-2xl overflow-hidden h-full flex flex-col border border-border/50 hover:border-primary/30 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-primary/10">
	<div class="p-6 flex flex-col flex-1">
		<div class="flex items-start justify-between gap-4 mb-4">
			<h3 class="text-lg font-semibold text-foreground tracking-tight group-hover:text-primary transition-colors duration-300">{title}</h3>
			<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-primary/10 via-purple-500/10 to-pink-500/10 flex items-center justify-center group-hover:from-primary/20 group-hover:via-purple-500/20 group-hover:to-pink-500/20 transition-all duration-300">
				<Icon name="layers" size={20} class="text-primary" />
			</div>
		</div>
		
		<p class="text-sm text-muted-foreground leading-relaxed mb-5 flex-1">{description}</p>
		
		<div class="flex flex-wrap gap-2 mb-5">
			{tags.map(tag => (
				<span class="text-xs font-medium px-3 py-1.5 bg-secondary/80 text-secondary-foreground rounded-full border border-border/50 group-hover:bg-primary/10 group-hover:text-primary group-hover:border-primary/20 transition-all duration-300">
					{tag}
				</span>
			))}
		</div>
		
		<a 
			href={link} 
			class="flex items-center justify-between px-5 py-3.5 bg-secondary/80 rounded-xl text-sm font-medium text-muted-foreground overflow-hidden relative group/link border border-transparent hover:border-primary/20"
			target={link.startsWith('http') ? '_blank' : undefined}
			rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
		>
			<span class="relative z-10 group-hover/link:text-white transition-colors duration-300">查看详情</span>
			<span class="relative z-10 opacity-70 group-hover/link:opacity-0 group-hover/link:translate-x-4 transition-all duration-300">
				<Icon name="open_in_new" size={14} />
			</span>
			<span class="absolute right-5 opacity-0 -translate-x-4 group-hover/link:opacity-100 group-hover/link:translate-x-0 transition-all duration-300 text-white">
				<Icon name="arrow_forward" size={16} />
			</span>
			<span class="absolute inset-0 bg-gradient-to-r from-primary via-purple-500 to-pink-500 opacity-0 group-hover/link:opacity-100 transition-opacity duration-300" />
		</a>
	</div>
</article>
