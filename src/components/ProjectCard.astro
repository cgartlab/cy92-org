---
import Icon from './Icon.astro';

interface Props {
	title: string;
	description: string;
	link: string;
	tags: string[];
}

const { title, description, link, tags } = Astro.props;
---

<article class="card p-5 group">
	<div class="flex items-start justify-between gap-3 mb-3">
		<h3 class="text-base font-medium text-foreground group-hover:text-ink transition-colors" style="font-family: var(--font-serif);">
			{title}
		</h3>
		<a
			href={link}
			target="_blank"
			rel="noopener noreferrer"
			class="flex-shrink-0 text-stone hover:text-ink transition-colors"
		>
			<Icon name="open_in_new" size={16} class="w-4 h-4" />
		</a>
	</div>

	<p class="text-sm text-olive leading-relaxed mb-4">{description}</p>

	<div class="flex flex-wrap gap-2">
		{tags.map(tag => (
			<span class="tag text-xs">{tag}</span>
		))}
	</div>
</article>
