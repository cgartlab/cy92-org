---
import Icon from './Icon.astro';
import { SOCIAL_LINKS } from '../consts';
const today = new Date();
---

<footer class="py-10 md:py-12 border-t" style="border-color: var(--ds-color-border-subtle);">
	<div class="container-custom">
		<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
			<div class="flex flex-col gap-3">
				<div class="flex items-center gap-1 text-sm" style="color: var(--ds-color-fg-subtle);">
					<span>&copy;</span>
					<span>{today.getFullYear()}</span>
					<span class="font-medium" style="font-family: var(--ds-font-display); color: var(--ds-color-fg);">ChenYang</span>
					<span style="color: var(--ds-color-muted);">·</span>
					<span style="color: var(--ds-accent);">CG艺术实验室</span>
				</div>
				<p class="text-sm italic max-w-md" style="color: var(--ds-color-muted); font-family: var(--ds-font-display);">
					工具是人类肢体的延伸，电脑是大脑的延伸，写作是思考本身。
				</p>
			</div>
			<div class="flex items-center gap-2">
				{SOCIAL_LINKS.map(link => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="social-link w-8 h-8"
						title={link.name}
					>
						<span class="sr-only">{link.name}</span>
						<Icon name={link.icon} size={15} class="w-3.5 h-3.5" fill />
					</a>
				))}
			</div>
		</div>
	</div>
</footer>
