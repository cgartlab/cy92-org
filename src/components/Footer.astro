---
import Icon from './Icon.astro';
import { SOCIAL_LINKS } from '../consts';
const today = new Date();
---

<footer class="py-12 md:py-16" style="border-top: 1px solid var(--ds-color-border-subtle);">
	<div class="container-custom">
		<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
			<div class="flex flex-col gap-2">
				<div class="text-sm" style="color: var(--ds-color-muted);">
					<span>&copy;</span>
					<span>{today.getFullYear()}</span>
					<span class="font-medium" style="color: var(--ds-color-fg);">ChenYang</span>
				</div>
				<p class="text-xs italic" style="color: var(--ds-color-muted);">
					<span data-t="footerQuoteTools">Tools extend our limbs, computers extend our minds, and writing is thinking itself.</span>
				</p>
			</div>
			<div class="flex items-center gap-2">
				{SOCIAL_LINKS.map(link => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="social-link w-8 h-8"
						title={link.nameEn}
						data-t-title={link.i18n}
					>
						<span class="sr-only"><span data-l="zh">{link.name}</span><span data-l="en">{link.nameEn}</span></span>
						<Icon name={link.icon} size={14} class="w-3.5 h-3.5" fill />
					</a>
				))}
			</div>
		</div>
	</div>
</footer>
