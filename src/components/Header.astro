---
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<header id="site-header" class="sticky top-0 z-50 border-b transition-shadow duration-300" style="border-color: var(--ds-glass-border); background: var(--ds-glass-bg); backdrop-filter: blur(var(--ds-blur-lg)); -webkit-backdrop-filter: blur(var(--ds-blur-lg));">
	<div class="container-custom flex h-14 items-center justify-between">
		<a href="/" class="text-base font-medium transition-colors duration-200" style="font-family: var(--ds-font-display); color: var(--ds-color-fg-strong);" aria-label="返回首页">
			{SITE_TITLE.split(' | ')[0]}
		</a>

		<nav class="hidden md:flex items-center gap-1" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/works">作品</HeaderLink>
			<a href="https://cgartlab.com" target="_blank" rel="noopener noreferrer" class="text-sm px-3 py-1.5 rounded-md transition-colors duration-200" style="color: var(--ds-color-muted);" onmouseover="this.style.color='var(--ds-color-fg)';this.style.background='var(--ds-accent-muted)'" onmouseout="this.style.color='var(--ds-color-muted)';this.style.background='transparent'">博客</a>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>

		<div class="hidden md:flex items-center gap-1">
			{SOCIAL_LINKS.slice(0, 3).map(link => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					title={link.name}
					class="social-link w-8 h-8"
				>
					<span class="sr-only">{link.name}</span>
					<Icon name={link.icon} size={16} class="w-4 h-4" fill />
				</a>
			))}

			<button
				id="theme-toggle"
				class="social-link w-8 h-8 ml-1"
				aria-label="切换主题"
			>
				<Icon name="dark_mode" size={16} class="w-4 h-4 hidden dark:block" fill />
				<Icon name="light_mode" size={16} class="w-4 h-4 block dark:hidden" fill />
			</button>
		</div>

		<button
			id="mobile-menu-btn"
			class="md:hidden flex items-center justify-center w-9 h-9 rounded-md hover:bg-secondary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 transition-colors"
			aria-label="打开菜单"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<Icon name="menu" size={18} class="w-[18px] h-[18px] menu-icon-open" fill />
			<Icon name="close" size={18} class="w-[18px] h-[18px] menu-icon-close hidden" fill />
		</button>
	</div>

	<div
		id="mobile-nav"
		class="md:hidden border-t overflow-hidden transition-all duration-350"
		style="border-color: var(--ds-color-border-subtle); background: var(--ds-color-bg); max-height: 0; opacity: 0; transform: translateY(-8px); transition-property: max-height, opacity, transform; transition-timing-function: cubic-bezier(0.25, 1, 0.5, 1); transition-duration: 350ms; will-change: max-height, opacity, transform;"
		role="navigation"
		aria-label="移动端导航"
	>
		<nav class="container-custom py-3 flex flex-col gap-1">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/works">作品</HeaderLink>
			<a href="https://cgartlab.com" target="_blank" rel="noopener noreferrer" class="text-sm px-3 py-1.5 rounded-md transition-colors duration-200" style="color: var(--ds-color-muted);">博客</a>
			<HeaderLink href="/about">关于</HeaderLink>
		</nav>
		<div class="container-custom pb-3 flex gap-2 border-t pt-3" style="border-color: var(--ds-color-border-subtle);">
			{SOCIAL_LINKS.slice(0, 3).map(link => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					title={link.name}
					class="social-link w-8 h-8"
				>
					<span class="sr-only">{link.name}</span>
					<Icon name={link.icon} size={16} class="w-4 h-4" fill />
				</a>
			))}
			<button
				id="theme-toggle-mobile"
				class="social-link w-8 h-8"
				aria-label="切换主题"
			>
				<Icon name="dark_mode" size={16} class="w-4 h-4 hidden dark:block" fill />
				<Icon name="light_mode" size={16} class="w-4 h-4 block dark:hidden" fill />
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileNav = document.getElementById('mobile-nav');
	const iconOpen = menuBtn?.querySelector('.menu-icon-open');
	const iconClose = menuBtn?.querySelector('.menu-icon-close');
	let scrollPosition = 0;

	if (header) {
		window.addEventListener('scroll', () => {
			if (window.scrollY > 10) {
				header.classList.add('shadow-sm');
			} else {
				header.classList.remove('shadow-sm');
			}
		});
	}

	if (menuBtn && mobileNav) {
		const toggleMenu = (open: boolean) => {
			if (open) {
				scrollPosition = window.scrollY;
				document.body.style.overflow = 'hidden';
				document.body.style.position = 'fixed';
				document.body.style.top = `-${scrollPosition}px`;
				document.body.style.width = '100%';

				const height = mobileNav.scrollHeight;
				mobileNav.style.maxHeight = `${height}px`;
				mobileNav.style.opacity = '1';
				mobileNav.style.transform = 'translateY(0)';
				iconOpen?.classList.add('hidden');
				iconClose?.classList.remove('hidden');
			} else {
				document.body.style.overflow = '';
				document.body.style.position = '';
				document.body.style.top = '';
				document.body.style.width = '';
				window.scrollTo(0, scrollPosition);

				mobileNav.style.maxHeight = '0';
				mobileNav.style.opacity = '0';
				mobileNav.style.transform = 'translateY(-8px)';
				iconOpen?.classList.remove('hidden');
				iconClose?.classList.add('hidden');
			}

			menuBtn.setAttribute('aria-expanded', String(open));
			menuBtn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
		};

		menuBtn.addEventListener('click', () => {
			const isOpen = mobileNav.style.maxHeight !== '0px' && mobileNav.style.maxHeight !== '';
			toggleMenu(!isOpen);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				const isOpen = mobileNav.style.maxHeight !== '0px' && mobileNav.style.maxHeight !== '';
				if (isOpen) toggleMenu(false);
			}
		});

		mobileNav.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => toggleMenu(false));
		});
	}

	const themeToggle = document.getElementById('theme-toggle');
	const themeToggleMobile = document.getElementById('theme-toggle-mobile');

	const toggleTheme = () => {
		const isDark = document.documentElement.classList.toggle('dark');
		document.documentElement.setAttribute('data-theme', isDark ? 'dark' : '');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	};

	themeToggle?.addEventListener('click', toggleTheme);
	themeToggleMobile?.addEventListener('click', toggleTheme);
</script>
